{
  "_comment": "Sensitive fields and headers to redact in HAR files",
  "headers": {
    "_comment": "HTTP headers that contain sensitive data (case-insensitive)",
    "full_redact": [
      "authorization",
      "x-auth-token",
      "x-api-key",
      "x-session-id",
      "x-csrf-token"
    ],
    "cookie_redact": [
      "cookie",
      "set-cookie"
    ]
  },
  "fields": {
    "_comment": "Form field name patterns that indicate sensitive data",
    "auto_redact_patterns": [
      "password",
      "passwd",
      "pwd",
      "\\bpass",
      "secret",
      "token",
      "\\b(?:api[_-]?key|secret[_-]?key|access[_-]?key|private[_-]?key)\\b",
      "\\bauth(?:orization|_token|entication)?\\b",
      "credential",
      "apikey",
      "api_key"
    ],
    "flag_patterns": [
      "\\buser(?:_?name)?\\b",
      "login",
      "\\bdomain\\b",
      "tenant",
      "\\bclient_id\\b",
      "\\baccount_id\\b",
      "\\borg(?:anization)?\\b",
      "\\benv(?:ironment)?\\b"
    ]
  },
  "tagValueList": {
    "_comment": "Universal safe values in pipe-delimited data (case-insensitive exact match). Domain-specific values belong in patterns/domains/ files.",
    "safe_values": [
      "good",
      "locked",
      "not locked",
      "unknown",
      "operational",
      "ok",
      "none",
      "&nbsp;",
      "enabled",
      "disabled",
      "retail",
      "success",
      "primary",
      "enable",
      "off",
      "on",
      "both",
      "in progress",
      "synchronized",
      "not synchronized",
      "done"
    ]
  }
}
