{
  "_comment": "PII detection patterns for sanitization and validation",
  "patterns": {
    "mac_address": {
      "regex": "(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}",
      "replacement_prefix": "MAC",
      "description": "MAC addresses in colon or dash format (mirrors MAC_RE in redaction.py)"
    },
    "serial_number": {
      "regex": "\\b(Serial\\s*Number|SerialNum|Serial\\s*No|Serial(?:\\s*ID)?(?=\\s*(?:</\\w+>\\s*)*[.:=])|SN|S/N)\\b(\\s*(?:</\\w+>\\s*)*[.:\\s=]*(?:<(?:=\\s*\\\\?\"[^\"]{0,2048}\"|=\\s*\\\\?'[^']{0,2048}'|[^<>\"'])*>\\s*)*)((?=[a-zA-Z0-9\\-_]*\\d)(?![A-Za-z0-9._%+-]+@[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*\\.[A-Za-z]{2,}\\b)[a-zA-Z0-9\\-_]{5,})",
      "value_group": 3,
      "replacement_prefix": "SERIAL",
      "flags": ["IGNORECASE"],
      "description": "Labeled serial numbers (mirrors SERIAL_LABEL_RE in sanitization/html.py): a serial label, its separator and tags, and a value carrying a digit"
    },
    "wps_pin": {
      "regex": "(WPS[\\s_-]*PIN|PIN[\\s_-]*Code|Pairing[\\s_-]*PIN|Default[\\s_-]*PIN)\\b(\\s*[:\\s=]*(?:<(?:=\\s*\\\\?\"[^\"]{0,2048}\"|=\\s*\\\\?'[^']{0,2048}'|[^<>\"'])*>\\s*)*)(\\d{8})\\b",
      "value_group": 3,
      "replacement_prefix": "PIN",
      "flags": ["IGNORECASE"],
      "description": "WPS / pairing / default PIN labels followed by an 8-digit code"
    },
    "account_id": {
      "regex": "((?:Account|Subscriber|Customer|Device)\\s*(?:ID|Number)\\s*[:\\s=]+(?:<(?:=\\s*\\\\?\"[^\"]{0,2048}\"|=\\s*\\\\?'[^']{0,2048}'|[^<>\"'])*>\\s*)*[\\\"']?)([^\\s<>\\\"'&;]+)",
      "value_group": 2,
      "replacement_prefix": "ACCOUNT",
      "flags": ["IGNORECASE"],
      "description": "Account, subscriber, or customer IDs (mirrors ACCOUNT_LABEL_RE in sanitization/html.py): the label, its separator and any tags, then the value"
    },
    "private_ip": {
      "regex": "\\b(?:10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|172\\.(?:1[6-9]|2[0-9]|3[01])\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3})\\b",
      "replacement_prefix": "PRIV_IP",
      "description": "Private IP addresses (PRIVATE_IP_RE; preserved_gateway_ips are kept)"
    },
    "public_ip": {
      "regex": "\\b(?!10\\.)(?!172\\.(?:1[6-9]|2[0-9]|3[01])\\.)(?!192\\.168\\.)(?!127\\.)(?!0\\.)(?!255\\.)(?:[1-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\b",
      "replacement_prefix": "PUB_IP",
      "description": "Public IP addresses"
    },
    "ipv6": {
      "regex": "(?<![:\\w])(?:[0-9a-f]{0,4}:){2,7}(?:\\d{1,3}(?:\\.\\d{1,3}){3}|[0-9a-f]{0,4})(?![:\\w])(?!\\.\\d)",
      "replacement_prefix": "IPV6",
      "flags": ["IGNORECASE"],
      "description": "IPv6 addresses (IPV6_RE; check_for_pii keeps only host addresses, as the sanitizer does)"
    },
    "email": {
      "regex": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*\\.[A-Za-z]{2,}\\b",
      "replacement_prefix": "EMAIL",
      "description": "Email addresses (RFC 5321 simplified)"
    },
    "password_field": {
      "regex": "(password|passphrase|psk|wpa[0-9]*key|(?<=[A-Za-z0-9_])key)(\\s*[=:]\\s*(?:&(?:nbsp|ensp|emsp|thinsp|#160|#x[aA]0);\\s*)*(?:\\\\*[\\\"']|(?![!&]|[A-Za-z_$][\\w$]*(?:\\.[\\w$]+)*\\()))((?:[^\"'<>\\s\\\\]|\\\\+(?=[^\"'<>\\s\\\\]))+)",
      "value_group": 3,
      "replacement_prefix": "PASS",
      "flags": ["IGNORECASE"],
      "description": "Password fields in HTML/text"
    },
    "password_input": {
      "regex": "(<input(?:(?!type=(?:\\\\*[\\\"'])?password)(?:=\\s*\\\\?\"[^\"]{0,2048}\"|=\\s*\\\\?'[^']{0,2048}'|[^<>\"']))*type=(?:\\\\*[\\\"'])?password(?:\\\\*[\\\"'])?(?:=\\s*\\\\?\"[^\"]{0,2048}\"|=\\s*\\\\?'[^']{0,2048}'|[^<>\"'])*value=(?:\\\\*[\\\"'])?)((?<=\")(?!')(?:[^\"\\\\]|\\\\+(?=[^\"\\\\]))+|(?<=')(?!\")(?:[^'\\\\]|\\\\+(?=[^'\\\\]))+|(?<![\"'\\\\])[^\\s\"'\\\\>]+)((?:\\\\*[\\\"'])?)",
      "value_group": 2,
      "replacement_prefix": "PASS",
      "flags": ["IGNORECASE"],
      "description": "Password input field values"
    },
    "session_token": {
      "regex": "(session|token|auth|cookie)(\\s*[=:]\\s*(?:&(?:nbsp|ensp|emsp|thinsp|#160|#x[aA]0);\\s*)*(?:\\\\*[\\\"']|(?![!&]|[A-Za-z_$][\\w$]*(?:\\.[\\w$]+)*\\()))((?:[^\"'<>\\s\\\\]|\\\\+(?=[^\"'<>\\s\\\\])){20,})",
      "value_group": 3,
      "replacement_prefix": "TOKEN",
      "flags": ["IGNORECASE"],
      "description": "Session tokens and auth cookies"
    },
    "csrf_token": {
      "regex": "(<meta(?:(?!name=(?:\\\\*[\\\"'])?csrf-token)(?:=\\s*\\\\?\"[^\"]{0,2048}\"|=\\s*\\\\?'[^']{0,2048}'|[^<>\"']))*name=(?:\\\\*[\\\"'])?csrf-token(?:\\\\*[\\\"'])?(?:=\\s*\\\\?\"[^\"]{0,2048}\"|=\\s*\\\\?'[^']{0,2048}'|[^<>\"'])*content=(?:\\\\*[\\\"'])?)((?<=\")(?!')(?:[^\"\\\\]|\\\\+(?=[^\"\\\\]))+|(?<=')(?!\")(?:[^'\\\\]|\\\\+(?=[^'\\\\]))+|(?<![\"'\\\\])[^\\s\"'\\\\>]+)((?:\\\\*[\\\"'])?)",
      "value_group": 2,
      "replacement_prefix": "CSRF",
      "flags": ["IGNORECASE"],
      "description": "CSRF tokens in meta tags"
    },
    "config_path": {
      "regex": "(Config\\s*File\\s*Name|config\\s*file)\\s*[:\\s=]+([^\\s<>]+\\.cfg)",
      "value_group": 2,
      "replacement_prefix": "CONFIG",
      "flags": ["IGNORECASE"],
      "description": "Configuration file paths"
    },
    "ssn": {
      "regex": "\\b\\d{3}-\\d{2}-\\d{4}\\b",
      "replacement_prefix": "SSN",
      "description": "US Social Security Numbers (xxx-xx-xxxx)"
    },
    "credit_card_visa": {
      "regex": "\\b4[0-9]{12}(?:[0-9]{3})?\\b",
      "replacement_prefix": "CC",
      "description": "Visa credit card numbers"
    },
    "credit_card_mastercard": {
      "regex": "\\b5[1-5][0-9]{14}\\b",
      "replacement_prefix": "CC",
      "description": "Mastercard credit card numbers"
    },
    "credit_card_amex": {
      "regex": "\\b3[47][0-9]{13}\\b",
      "replacement_prefix": "CC",
      "description": "American Express credit card numbers"
    }
  },
  "preserved_gateway_ips": [
    "192.168.100.1",
    "192.168.0.1",
    "192.168.1.1",
    "10.0.0.1"
  ]
}
