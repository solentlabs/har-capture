{
  "_comment": "Values recognized as already-redacted (not flagged as PII)",

  "static_placeholders": {
    "_comment": "Exact values produced when salt=None",
    "values": [
      "XX:XX:XX:XX:XX:XX",
      "0.0.0.0",
      "::",
      "x@x.invalid",
      "[REDACTED]"
    ]
  },

  "format_preserving_patterns": {
    "_comment": "Regex patterns for format-preserving hashes (RFC-reserved ranges)",
    "mac": {
      "pattern": "^02([:-])[0-9a-f]{2}(?:\\1[0-9a-f]{2}){4}$",
      "description": "Locally administered MAC, colon or hyphen layout (02:xx:xx:xx:xx:xx, 02-xx-xx-xx-xx-xx)"
    },
    "private_ip": {
      "pattern": "^10\\.255\\.\\d{1,3}\\.\\d{1,3}$",
      "description": "Redacted private IP (10.255.x.x)"
    },
    "public_ip": {
      "pattern": "^192\\.0\\.2\\.\\d{1,3}$",
      "description": "TEST-NET-1 documentation range (RFC 5737)"
    },
    "ipv6": {
      "pattern": "^2001:db8::",
      "description": "IPv6 documentation prefix (RFC 3849)"
    },
    "email": {
      "pattern": "@redacted\\.invalid$",
      "description": "Reserved .invalid TLD (RFC 2606)"
    }
  },

  "hash_prefixes": {
    "_comment": "Prefixes for non-format-preserving hashes (PREFIX_xxxxxxxx)",
    "values": [
      "SERIAL_",
      "ACCOUNT_",
      "PASS_",
      "TOKEN_",
      "CSRF_",
      "CONFIG_",
      "WIFI_",
      "DEVICE_",
      "FIELD_",
      "AUTH_",
      "COOKIE_",
      "STORAGE_",
      "CRED_",
      "SENSITIVE_",
      "PHONE_",
      "SSN_",
      "PIN_"
    ]
  },

  "protocol_keywords": {
    "_comment": "Exact values a client submits under a credential-named field as a protocol keyword, not a credential; kept as sent",
    "values": [
      "seeksalthash"
    ]
  },

  "registered_headers": {
    "_comment": "Standard HTTP header names (lowercase): protocol structure whose values are never swapped for a cookie placeholder when they equal a redacted cookie value. Any other header name carrying such a value is an echo of the cookie.",
    "values": [
      "accept",
      "accept-charset",
      "accept-datetime",
      "accept-encoding",
      "accept-language",
      "accept-patch",
      "accept-ranges",
      "access-control-allow-credentials",
      "access-control-allow-headers",
      "access-control-allow-methods",
      "access-control-allow-origin",
      "access-control-expose-headers",
      "access-control-max-age",
      "access-control-request-headers",
      "access-control-request-method",
      "age",
      "allow",
      "alt-svc",
      "cache-control",
      "connection",
      "content-disposition",
      "content-encoding",
      "content-language",
      "content-length",
      "content-location",
      "content-range",
      "content-security-policy",
      "content-security-policy-report-only",
      "content-type",
      "date",
      "dnt",
      "etag",
      "expect",
      "expires",
      "forwarded",
      "from",
      "host",
      "if-match",
      "if-modified-since",
      "if-none-match",
      "if-range",
      "if-unmodified-since",
      "keep-alive",
      "last-modified",
      "link",
      "location",
      "max-forwards",
      "origin",
      "pragma",
      "proxy-authenticate",
      "range",
      "referer",
      "referrer-policy",
      "refresh",
      "retry-after",
      "sec-fetch-dest",
      "sec-fetch-mode",
      "sec-fetch-site",
      "sec-fetch-user",
      "server",
      "strict-transport-security",
      "te",
      "trailer",
      "transfer-encoding",
      "upgrade",
      "upgrade-insecure-requests",
      "user-agent",
      "vary",
      "via",
      "warning",
      "www-authenticate",
      "x-content-type-options",
      "x-forwarded-for",
      "x-forwarded-host",
      "x-forwarded-proto",
      "x-frame-options",
      "x-requested-with",
      "x-xss-protection"
    ]
  },

  "redaction_patterns": {
    "_comment": "Regex patterns that indicate a value is already redacted",
    "values": [
      "\\[REDACTED\\]",
      "REDACTED",
      "XXX+",
      "0{6,}",
      "\\*\\*\\*[A-Z]+\\*\\*\\*",
      "COOKIE_[a-f0-9]{8}",
      "MAC_[a-f0-9]{8}",
      "PASS_[a-f0-9]{8}",
      "TOKEN_[a-f0-9]{8}",
      "FIELD_[a-f0-9]{8}",
      "AUTH_[a-f0-9]{8}"
    ]
  }
}
