    {"content": "<tr><td>Cable Modem Serial Number</td><td><?get_cm_sn></td></tr><tr><td>Firmware Name:</td><td>SB8200.0200.174F.311915</td></tr>", "expect_serial_warning": false, "id": "label_does_not_span_elements_to_another_colon"},
    {"content": "<td>Serial No.:</td><td>7ZZ0000FAKE00</td>", "expect_serial_warning": true, "id": "short_label_before_colon_detected"},
    {"content": "SN: ABCD1234EFGH",                      "expect_serial_warning": true,  "id": "sn_label_detected"},
    {"content": "<p><b>Serial Number</b>: ABC1234567</p>", "expect_serial_warning": true, "id": "label_closed_before_colon_detected"},
    {"content": "<span class=\"lbl\">Serial Number</span>: <span>ABC1234567</span>", "expect_serial_warning": true, "id": "label_span_closed_before_colon_detected"},
    {"content": "<td>Serial Number</td><td>Unavailable</td>", "expect_serial_warning": false, "id": "digitless_table_cell_value_ignored"},
    {"content": "<p><b>SN</b>: 7ZZ0000FAKE00</p>", "expect_serial_warning": true, "id": "sn_label_closed_before_colon_detected"},
    {"content": "<p><b>S/N</b>: 7ZZ0000FAKE00</p>", "expect_serial_warning": true, "id": "s_slash_n_label_detected"},
    {"content": "SNR: 38.5 dB, ISN 12345678", "expect_serial_warning": false, "id": "sn_inside_other_words_ignored"},
    {"content": "<p>Serial No: ABC1234567</p>", "expect_serial_warning": true, "id": "serial_no_label_detected"},
    {"content": "<p>Serial ID: ABC1234567</p>", "expect_serial_warning": true, "id": "serial_id_label_detected"},
    {"content": "<p>cmSerialNumber: ABC1234567</p>", "expect_serial_warning": false, "id": "label_glued_to_identifier_ignored"},
    {"content": "<p>Serial: ABC1234567</p>", "expect_serial_warning": true, "id": "bare_serial_label_detected"},
    {"content": "<td>Serial:</td><td>ABC1234567</td>", "expect_serial_warning": true, "id": "bare_serial_table_label_detected"},
    {"content": "the serial port 2 is COM3", "expect_serial_warning": false, "id": "bare_serial_without_separator_ignored"}
  ],
  "vendor_serial_cases": [
