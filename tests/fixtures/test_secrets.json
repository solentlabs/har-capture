{
  "validate_har_gzipped": {
    "log": {
      "entries": [
        {
          "request": {
            "url": "http://example.com",
            "headers": [
              {"name": "Cookie", "value": "session=abc123"}
            ]
          },
          "response": {"headers": []}
        }
      ]
    }
  },
  "redacted_cases": [
    {"value": "[REDACTED]",           "expected": true,  "id": "standard_redaction"},
    {"value": "REDACTED",             "expected": true,  "id": "plain_REDACTED"},
    {"value": "xxx REDACTED xxx",     "expected": true,  "id": "contains_REDACTED"},
    {"value": "<REDACTED>",           "expected": true,  "id": "angle_bracket_REDACTED"},
    {"value": "***REDACTED***",       "expected": true,  "id": "asterisk_REDACTED"},
    {"value": "redacted",             "expected": true,  "id": "lowercase_redacted"},
    {"value": "Redacted",             "expected": true,  "id": "title_case_Redacted"},
    {"value": "REDACTED_VALUE",       "expected": true,  "id": "redacted_with_suffix"},
    {"value": "XXXX",                 "expected": true,  "id": "X_placeholder_4"},
    {"value": "XXXXXXXXXX",           "expected": true,  "id": "long_X_placeholder_10"},
    {"value": "xxxx",                 "expected": true,  "id": "lowercase_x_placeholder"},
    {"value": "XX:XX:XX:XX:XX:XX",    "expected": true,  "id": "redacted_MAC"},
    {"value": "xx:xx:xx:xx:xx:xx",    "expected": false, "id": "lowercase_redacted_MAC_not_detected"},
    {"value": "000000",               "expected": true,  "id": "all_zeros_6"},
    {"value": "0000000000",           "expected": true,  "id": "all_zeros_10"},
    {"value": "111111",               "expected": false, "id": "all_ones_not_detected"},
    {"value": "999999999",            "expected": false, "id": "all_nines_not_detected"},
    {"value": "0.0.0.0",              "expected": true,  "id": "zero_IP_allowlisted"},
    {"value": "::",                   "expected": true,  "id": "empty_IPv6_allowlisted"},
    {"value": "x@x.invalid",          "expected": true,  "id": "redacted_email_x_at_x"},
    {"value": "user@example.invalid", "expected": false, "id": "invalid_TLD_not_detected"},
    {"value": "real-secret-value",    "expected": false, "id": "actual_secret"},
    {"value": "Bearer token123",      "expected": false, "id": "auth_token"},
    {"value": "password123",          "expected": false, "id": "password"},
    {"value": "abc123xyz",            "expected": false, "id": "mixed_alphanumeric"},
    {"value": "00000",                "expected": false, "id": "5_zeros_not_enough"},
    {"value": "XXX",                  "expected": true,  "id": "3_Xs_minimum_threshold"},
    {"value": "XX",                   "expected": false, "id": "2_Xs_not_enough"},
    {"value": "111",                  "expected": false, "id": "3_ones_not_detected"},
    {"value": "user123",              "expected": false, "id": "username_like"},
    {"value": "test@example.com",     "expected": false, "id": "valid_email"},
    {"value": "192.168.1.1",          "expected": false, "id": "private_IP_not_redacted_placeholder"}
  ],
  "cookie_attr_cases": [
    {"value": "Secure",              "expected": true,  "id": "just_Secure"},
    {"value": "HttpOnly",            "expected": true,  "id": "just_HttpOnly"},
    {"value": "Secure; HttpOnly",    "expected": true,  "id": "both_attributes"},
    {"value": "HttpOnly; Secure",    "expected": true,  "id": "both_reversed"},
    {"value": "",                    "expected": true,  "id": "empty_string"},
    {"value": "  ",                  "expected": true,  "id": "whitespace_only"},
    {"value": "session=abc123",      "expected": false, "id": "actual_session_value"},
    {"value": "Secure; session=abc", "expected": false, "id": "attributes_plus_value"},
    {"value": "token=xyz; HttpOnly", "expected": false, "id": "value_plus_attributes"}
  ],
  "private_ip_cases": [
    {"ip": "10.0.0.0",          "expected": true,  "id": "10x_network_address"},
    {"ip": "10.0.0.1",          "expected": true,  "id": "10x_range_start"},
    {"ip": "10.100.50.25",      "expected": true,  "id": "10x_middle"},
    {"ip": "10.255.255.255",    "expected": true,  "id": "10x_broadcast"},
    {"ip": "172.16.0.1",        "expected": true,  "id": "172_16x_start"},
    {"ip": "172.20.100.50",     "expected": true,  "id": "172x_middle"},
    {"ip": "172.31.255.255",    "expected": true,  "id": "172_31x_end"},
    {"ip": "192.168.0.1",       "expected": true,  "id": "192_168_0x_gateway"},
    {"ip": "192.168.1.1",       "expected": true,  "id": "192_168_1x_gateway"},
    {"ip": "192.168.100.1",     "expected": true,  "id": "192_168_xx_modem"},
    {"ip": "192.168.255.255",   "expected": true,  "id": "192_168x_broadcast"},
    {"ip": "127.0.0.0",         "expected": true,  "id": "loopback_network"},
    {"ip": "127.0.0.1",         "expected": true,  "id": "localhost"},
    {"ip": "127.255.255.255",   "expected": true,  "id": "loopback_end"},
    {"ip": "169.254.0.1",       "expected": false, "id": "link_local_not_detected"},
    {"ip": "169.254.100.50",    "expected": false, "id": "link_local_mid_not_detected"},
    {"ip": "169.254.255.255",   "expected": false, "id": "link_local_end_not_detected"},
    {"ip": "0.0.0.0",           "expected": true,  "id": "all_zeros_redacted"},
    {"ip": "8.8.8.8",           "expected": false, "id": "Google_DNS"},
    {"ip": "8.8.4.4",           "expected": false, "id": "Google_DNS_secondary"},
    {"ip": "1.1.1.1",           "expected": false, "id": "Cloudflare_DNS"},
    {"ip": "208.67.222.222",    "expected": false, "id": "OpenDNS"},
    {"ip": "9.9.9.9",           "expected": false, "id": "Quad9"},
    {"ip": "9.255.255.255",     "expected": false, "id": "just_before_10x"},
    {"ip": "11.0.0.1",          "expected": false, "id": "just_after_10x"},
    {"ip": "172.15.255.255",    "expected": false, "id": "just_before_172_16"},
    {"ip": "172.32.0.1",        "expected": false, "id": "just_after_172_31"},
    {"ip": "192.167.255.255",   "expected": false, "id": "just_before_192_168"},
    {"ip": "192.169.0.1",       "expected": false, "id": "just_after_192_168"},
    {"ip": "169.253.255.255",   "expected": false, "id": "just_before_link_local"},
    {"ip": "169.255.0.1",       "expected": false, "id": "just_after_link_local"},
    {"ip": "192.0.2.1",         "expected": false, "id": "TEST_NET_1"},
    {"ip": "198.51.100.1",      "expected": false, "id": "TEST_NET_2"},
    {"ip": "203.0.113.1",       "expected": false, "id": "TEST_NET_3"},
    {"ip": "invalid",           "expected": false, "id": "not_an_IP"},
    {"ip": "256.0.0.1",         "expected": false, "id": "invalid_octet_over_255"},
    {"ip": "-1.0.0.0",          "expected": false, "id": "negative_octet"},
    {"ip": "1.2.3",             "expected": false, "id": "too_few_octets"},
    {"ip": "1.2.3.4.5",         "expected": false, "id": "too_many_octets"},
    {"ip": "",                  "expected": false, "id": "empty_string"},
    {"ip": "abc.def.ghi.jkl",   "expected": false, "id": "non_numeric_octets"}
  ],
  "truncate_cases": [
    {"value": "short",  "max_len": 40, "expected": "short",  "id": "under_limit_unchanged"},
    {"value": "_X40_",  "max_len": 40, "expected": "_X40_",  "id": "exact_limit_unchanged"},
    {"value": "_X50_",  "max_len": 40, "expected": "_X37_...", "id": "over_limit_truncated"},
    {"value": "abcdefghij", "max_len": 5, "expected": "ab...", "id": "custom_limit"}
  ],
  "_truncate_note": "Values _X40_, _X50_, _X37_ are sentinel placeholders expanded at load time to 'x' * N.",
  "check_json_fields_cases": [
    {"data": {"username": "operator7", "password": "secret123"},                    "expected_count": 2, "id": "username_and_password_fields_detected"},
    {"data": {"username": "admin", "password": "secret123"},                        "expected_count": 1, "id": "default_username_suppressed_password_still_error"},
    {"data": {"loginName": "admin"},                                                "expected_count": 0, "id": "default_username_alone_suppressed"},
    {"data": {"user": {"credentials": {"api_key": "abc123xyz"}}},                   "expected_count": 1, "id": "nested_api_key_field"},
    {"data": {"password": "[REDACTED]"},                                            "expected_count": 0, "id": "redacted_value_ignored"},
    {"data": {"password": ""},                                                      "expected_count": 0, "id": "empty_value_ignored"},
    {"data": [{"token": "secret1"}, {"token": "secret2"}],                          "expected_count": 2, "id": "list_of_objects"},
    {"data": {"items": [{"credentials": {"password": "secret"}}]},                  "expected_count": 1, "id": "nested_in_list"},
    {"data": {"safe_field": "not sensitive"},                                       "expected_count": 0, "id": "non_sensitive_field"}
  ],
  "check_content_cases": [
    {"content": "Server is at 203.0.113.45 and ready", "expect_ip": true,  "expect_mac": false, "id": "public_IP_detected"},
    {"content": "Local server at 192.168.1.1",         "expect_ip": false, "expect_mac": false, "id": "private_IP_ignored"},
    {"content": "Device MAC is AA:BB:CC:11:22:33",     "expect_ip": false, "expect_mac": true,  "id": "MAC_address_detected"},
    {"content": "MAC: 00:00:00:00:00:00",              "expect_ip": false, "expect_mac": false, "id": "anonymized_MAC_ignored"},
    {"content": "",                                    "expect_ip": false, "expect_mac": false, "id": "empty_content"},
    {"content": "[REDACTED]",                          "expect_ip": false, "expect_mac": false, "id": "redacted_content"},
    {"content": "Subnet Mask: 255.255.255.0",          "expect_ip": false, "expect_mac": false, "id": "netmask_slash24_ignored"},
    {"content": "Mask 255.255.252.0 on wan0",          "expect_ip": false, "expect_mac": false, "id": "netmask_slash22_ignored"},
    {"content": "Broadcast 255.255.255.255 seen",      "expect_ip": false, "expect_mac": false, "id": "broadcast_mask_ignored"},
    {"content": "Non-mask 255.0.255.0 stays odd",      "expect_ip": false, "expect_mac": false, "id": "reserved_255_prefix_ignored"},
    {"content": "jquery version 1.12.4.5 loaded",      "expect_ip": false, "expect_mac": false, "id": "version_string_ignored"},
    {"content": "DNS at 8.8.8.8 responding",           "expect_ip": true,  "expect_mac": false, "id": "repeated_octet_public_ip_detected"}
  ],
  "netmask_cases": [
    {"ip": "255.255.255.0",   "expected": true,  "id": "slash24"},
    {"ip": "255.255.252.0",   "expected": true,  "id": "slash22"},
    {"ip": "255.0.0.0",       "expected": true,  "id": "slash8"},
    {"ip": "255.255.255.255", "expected": true,  "id": "slash32_broadcast"},
    {"ip": "0.0.0.0",         "expected": true,  "id": "slash0"},
    {"ip": "255.0.255.0",     "expected": false, "id": "noncontiguous_bits"},
    {"ip": "203.0.113.45",    "expected": false, "id": "host_address"},
    {"ip": "255.255.255",     "expected": false, "id": "three_octets"},
    {"ip": "255.255.255.256", "expected": false, "id": "octet_out_of_range"},
    {"ip": "255.255.abc.0",   "expected": false, "id": "non_numeric_octet"}
  ],
  "serial_label_fp_cases": [
    {"content": "jQuery.fn.extend({serialize: function(){}, serializeArray: function(){}});", "expect_serial_warning": false, "id": "jquery_serialize_methods_ignored"},
    {"content": "serialport: function(){}",              "expect_serial_warning": false, "id": "digitless_value_after_label_ignored"},
    {"content": "Serial Number: 7ZZ0000FAKE00",          "expect_serial_warning": true,  "id": "labeled_serial_with_digits_detected"},
    {"content": "SN: ABCD1234EFGH",                      "expect_serial_warning": true,  "id": "sn_label_detected"}
  ],
  "vendor_serial_cases": [
    {"content": "var tagValueList = '1.01|V6.01.03|7ZZ0000FAKE00|1|Denied';", "expected_errors": 1, "id": "serial_in_pipe_blob_is_error"},
    {"content": "var tagValueList = '1.01|V6.01.03|SERIAL_2c9c9cf9|1';",      "expected_errors": 0, "id": "redacted_placeholder_clean"},
    {"content": "7ZZ0000FAKE00 7ZZ0000FAKE00 and 7ZZ0000FAKE00",              "expected_errors": 1, "id": "repeated_serial_reported_once"},
    {"content": "id=x7ZZ0000FAKE00 blob YWJj7ZZ0000FAKE00",                   "expected_errors": 0, "id": "embedded_in_longer_token_ignored"},
    {"content": "value V6010301AB123 versions 1732584193 uptime",             "expected_errors": 0, "id": "letter_led_and_pure_digit_tokens_ignored"},
    {"content": "totally serial-free content",                                "expected_errors": 0, "id": "no_candidates"}
  ],
  "form_field_severity_cases": [
    {"name": "loginName",     "value": "admin",         "expected_severity": null,      "id": "default_username_suppressed"},
    {"name": "loginName",     "value": "ADMIN",         "expected_severity": null,      "id": "default_username_case_insensitive"},
    {"name": "loginName",     "value": "operator7",     "expected_severity": "warning", "id": "real_username_warns"},
    {"name": "username",      "value": "kens-router",   "expected_severity": "warning", "id": "username_field_warns"},
    {"name": "loginPassword", "value": "admin",         "expected_severity": "error",   "id": "default_string_in_password_field_still_error"},
    {"name": "loginPassword", "value": "hunter2secret", "expected_severity": "error",   "id": "password_field_errors"},
    {"name": "token",         "value": "abc123def",     "expected_severity": "error",   "id": "token_field_errors"},
    {"name": "loginName",     "value": "PASS_ab12cd34", "expected_severity": null,      "id": "redacted_value_skipped"}
  ],
  "check_url_cases": [
    {"url": "https://192.168.100.1/status.html?YWRtaW46cGFzc3dvcmQ=", "expected_count": 1, "id": "bare_base64_user_pass"},
    {"url": "https://modem.local/api?auth=YWRtaW46cGFzc3dvcmQ=",      "expected_count": 1, "id": "base64_as_param_value"},
    {"url": "https://example.com/page?id=123&format=json",             "expected_count": 0, "id": "normal_params"},
    {"url": "https://example.com/page",                                "expected_count": 0, "id": "no_query_string"}
  ],
  "cookie_attr_extended_cases": [
    {"value": "HttpOnly: true, Secure: true",                   "expected": true,  "id": "metadata_with_colons"},
    {"value": "HttpOnly: true, Secure: true, SameSite: Strict", "expected": true,  "id": "three_attrs_metadata"},
    {"value": "Secure; HttpOnly",                               "expected": true,  "id": "standard_attributes"},
    {"value": "Secure",                                         "expected": true,  "id": "bare_secure"},
    {"value": "HttpOnly",                                       "expected": true,  "id": "bare_httponly"},
    {"value": "session=abc123",                                 "expected": false, "id": "actual_cookie_value"},
    {"value": "Bearer token123",                                "expected": false, "id": "auth_token"}
  ],
  "validate_har_url_cred_cases": [
    {"url": "https://192.168.100.1/status.html?YWRtaW46cGFzc3dvcmQ=", "expect_finding": true,  "id": "base64_cred_in_url"},
    {"url": "https://example.com/page?id=123",                         "expect_finding": false, "id": "clean_url"}
  ],
  "validate_har_cases": [
    {
      "har_data": {"log": {"entries": [{"request": {"url": "http://x.com", "headers": [{"name": "Authorization", "value": "Bearer secret"}]}, "response": {"headers": []}}]}},
      "expect_findings": true,
      "match_field": "Authorization",
      "id": "auth_header_detected"
    },
    {
      "har_data": {"log": {"entries": [{"request": {"url": "http://x.com", "headers": [{"name": "Content-Type", "value": "text/html"}]}, "response": {"headers": [], "content": {"text": "Hello", "mimeType": "text/html"}}}]}},
      "expect_findings": false,
      "match_field": null,
      "id": "clean_HAR"
    },
    {
      "har_data": {"log": {"entries": [{"request": {"url": "http://x.com/login", "headers": [], "postData": {"mimeType": "application/x-www-form-urlencoded", "params": [{"name": "password", "value": "mysecret"}]}}, "response": {"headers": []}}]}},
      "expect_findings": true,
      "match_field": "password",
      "id": "POST_password_detected"
    },
    {
      "har_data": {"log": {"entries": [{"request": {"url": "http://x.com", "headers": [{"name": "Cookie", "value": "session=abc123"}]}, "response": {"headers": []}}]}},
      "expect_findings": true,
      "match_field": "Cookie",
      "id": "cookie_header_detected"
    }
  ],

  "check_post_data_xml_cases": [
    {
      "id": "xml_password_element_detected",
      "post_data": {
        "mimeType": "text/xml",
        "text": "<request><password>mysecret</password></request>"
      },
      "expected_finding_count": 1
    },
    {
      "id": "xml_token_element_detected",
      "post_data": {
        "mimeType": "application/xml",
        "text": "<auth><token>abc123</token></auth>"
      },
      "expected_finding_count": 1
    },
    {
      "id": "xml_secret_element_detected",
      "post_data": {
        "mimeType": "text/xml",
        "text": "<login><secret>mysecretvalue</secret></login>"
      },
      "expected_finding_count": 1
    },
    {
      "id": "xml_redacted_password_no_finding",
      "post_data": {
        "mimeType": "text/xml",
        "text": "<request><password>PASS_a1b2c3d4</password></request>"
      },
      "expected_finding_count": 0
    },
    {
      "id": "xml_nonsensitive_no_finding",
      "post_data": {
        "mimeType": "application/xml",
        "text": "<downstream><freq>834000000</freq><mod>256qam</mod></downstream>"
      },
      "expected_finding_count": 0
    },
    {
      "id": "xml_malformed_no_crash",
      "post_data": {
        "mimeType": "text/xml",
        "text": "<broken><unclosed>"
      },
      "expected_finding_count": 0
    },
    {
      "id": "xml_empty_body_no_finding",
      "post_data": {
        "mimeType": "text/xml",
        "text": ""
      },
      "expected_finding_count": 0
    },
    {
      "id": "xml_sensitive_attribute_detected",
      "post_data": {
        "mimeType": "text/xml",
        "text": "<field password=\"mysecret\"/>"
      },
      "expected_finding_count": 1
    },
    {
      "id": "xml_redacted_attribute_no_finding",
      "post_data": {
        "mimeType": "text/xml",
        "text": "<field password=\"PASS_a1b2c3d4\"/>"
      },
      "expected_finding_count": 0
    },
    {
      "id": "xml_nonsensitive_attribute_no_finding",
      "post_data": {
        "mimeType": "text/xml",
        "text": "<channel id=\"30\" frequency=\"834000000\"/>"
      },
      "expected_finding_count": 0
    }
  ]
}
