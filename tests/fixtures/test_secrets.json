    {"value": "HttpOnly: true, Secure: true",                   "expected": true,  "id": "metadata_with_colons"},
    {"value": "HttpOnly: true, Secure: true, SameSite: Strict", "expected": true,  "id": "three_attrs_metadata"},
    {"value": "Secure; HttpOnly",                               "expected": true,  "id": "standard_attributes"},
    {"value": "Secure",                                         "expected": true,  "id": "bare_secure"},
    {"value": "HttpOnly",                                       "expected": true,  "id": "bare_httponly"},
    {"value": "session=abc123",                                 "expected": false, "id": "actual_cookie_value"},
    {"value": "Bearer token123",                                "expected": false, "id": "auth_token"}
  ],
  "validate_har_url_cred_cases": [
    {"url": "https://192.168.100.1/status.html?YWRtaW46cGFzc3dvcmQ=", "expect_finding": true,  "id": "base64_cred_in_url"},
    {"url": "https://192.168.100.1/status.html?login_YWRtaW46cGFzc3dvcmQ=", "expect_finding": true, "id": "prefixed_cred_in_url"},
    {"url": "https://modem.local/api?user=YWRtaW46cGFzc3dvcmQ=",       "expect_finding": true,  "id": "cred_under_flaggable_name"},
    {"url": "https://example.com/page?id=123",                         "expect_finding": false, "id": "clean_url"}
  ],
  "validate_har_query_cases": {
    "_comment": "One request per case. validate_har reads the query as the URL string, as the parsed queryString array, and inside URL-valued headers; the same finding in the URL and the array is one leak and is reported once.",
    "cases": [
      {"id": "credential_in_url_and_array_reported_once",
       "request": {"url": "https://d.local/s?login_YWRtaW46cGFzc3dvcmQ=", "headers": [], "queryString": [{"name": "login_YWRtaW46cGFzc3dvcmQ", "value": "="}]},
       "response_headers": [], "errors": 1, "warnings": 0},
      {"id": "credential_only_in_array",
       "request": {"url": "https://d.local/s?login_AUTH_1a2b3c4d", "headers": [], "queryString": [{"name": "login_YWRtaW46cGFzc3dvcmQ", "value": "="}]},
       "response_headers": [], "errors": 1, "warnings": 0},
      {"id": "password_param",
       "request": {"url": "https://d.local/login.cgi?password=hunter22", "headers": [], "queryString": [{"name": "password", "value": "hunter22"}]},
       "response_headers": [], "errors": 1, "warnings": 0},
      {"id": "password_param_redacted",
       "request": {"url": "https://d.local/login.cgi?password=FIELD_1a2b3c4d", "headers": [], "queryString": [{"name": "password", "value": "FIELD_1a2b3c4d"}]},
       "response_headers": [], "errors": 0, "warnings": 0},
      {"id": "password_param_empty",
       "request": {"url": "https://d.local/login.cgi?password=", "headers": [], "queryString": [{"name": "password", "value": ""}]},
       "response_headers": [], "errors": 0, "warnings": 0},
      {"id": "flag_tier_param_warns",
       "request": {"url": "https://d.local/login.cgi?username=bob", "headers": [], "queryString": [{"name": "username", "value": "bob"}]},
       "response_headers": [], "errors": 0, "warnings": 1},
      {"id": "flag_tier_default_username_suppressed",
       "request": {"url": "https://d.local/login.cgi?username=admin", "headers": [], "queryString": [{"name": "username", "value": "admin"}]},
       "response_headers": [], "errors": 0, "warnings": 0},
      {"id": "referer_carries_credential",
       "request": {"url": "https://d.local/next.html", "headers": [{"name": "Referer", "value": "https://d.local/s?login_YWRtaW46cGFzc3dvcmQ="}], "queryString": []},
       "response_headers": [], "errors": 1, "warnings": 0},
      {"id": "location_carries_password",
       "request": {"url": "https://d.local/next.html", "headers": [], "queryString": []},
       "response_headers": [{"name": "Location", "value": "https://d.local/home?password=hunter22"}], "errors": 1, "warnings": 0},
      {"id": "null_query_string",
       "request": {"url": "https://d.local/next.html", "headers": [], "queryString": null},
       "response_headers": [], "errors": 0, "warnings": 0},
      {"id": "redirect_url_carries_password",
       "request": {"url": "https://d.local/next.html", "headers": [], "queryString": []},
       "response_headers": [], "redirect_url": "/home?password=hunter22", "errors": 1, "warnings": 0},
      {"id": "padding_remnant_value_is_blank",
       "request": {"url": "https://d.local/s?login_AUTH_1a2b3c4d", "headers": [], "queryString": [{"name": "login_[REDACTED]", "value": "="}]},
       "response_headers": [], "errors": 0, "warnings": 0},
      {"id": "sanitizer_placeholder_not_a_credential",
       "request": {"url": "https://d.local/s?AUTH_d2c6b8e4", "headers": [], "queryString": [{"name": "AUTH_d2c6b8e4", "value": ""}]},
       "response_headers": [], "errors": 0, "warnings": 0},
      {"id": "malformed_query_string_entry_skipped",
       "request": {"url": "https://d.local/next.html", "headers": [], "queryString": ["not-a-dict", {"value": "x"}]},
       "response_headers": [], "errors": 0, "warnings": 0}
    ]
  },
  "validate_har_cases": [
    {
      "har_data": {"log": {"entries": [{"request": {"url": "http://x.com", "headers": [{"name": "Authorization", "value": "Bearer secret"}]}, "response": {"headers": []}}]}},
