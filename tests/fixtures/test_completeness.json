  "out_of_order_entries": {
    "_comment": "Foreign HARs are not guaranteed chronological. The earliest request (t=01) carries the session cookie but is written second; ordering must be resolved by startedDateTime.",
    "log": {
      "entries": [
        {
          "startedDateTime": "2026-01-01T00:00:05.000Z",
          "request": {
            "method": "POST",
            "url": "http://192.168.100.1/data",
            "headers": [],
            "postData": {
              "text": "a=1"
            }
          },
          "response": {
            "status": 200,
            "headers": []
          }
        },
        {
          "startedDateTime": "2026-01-01T00:00:01.000Z",
          "request": {
            "method": "GET",
            "url": "http://192.168.100.1/",
            "headers": [
              {
                "name": "Cookie",
                "value": "PHPSESSID=abc123"
              }
            ]
          },
          "response": {
            "status": 200,
            "headers": []
          }
        }
      ]
    }
  },
