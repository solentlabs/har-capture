{
  "_comment": "HAR fixtures for capture-completeness validation. The mid-session cases reproduce cable_modem_monitor issue #120, where a PHPSESSID cookie on the first request meant the login exchange happened before recording started.",
  "clean_login_flow": {
    "log": {
      "entries": [
        {
          "request": {
            "method": "GET",
            "url": "http://192.168.100.1/",
            "headers": [],
            "cookies": []
          },
          "response": {
            "status": 200,
            "headers": []
          }
        },
        {
          "request": {
            "method": "POST",
            "url": "http://192.168.100.1/api/v1/session/login",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ],
            "cookies": [],
            "postData": {
              "text": "{\"username\":\"admin\"}"
            }
          },
          "response": {
            "status": 200,
            "headers": []
          }
        },
        {
          "request": {
            "method": "POST",
            "url": "http://192.168.100.1/api/v1/session/login",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ],
            "cookies": [],
            "postData": {
              "text": "{\"password\":\"derived-key\"}"
            }
          },
          "response": {
            "status": 200,
            "headers": [
              {
                "name": "Set-Cookie",
                "value": "PHPSESSID=abc123; Path=/; HttpOnly"
              }
            ]
          }
        },
        {
          "request": {
            "method": "GET",
            "url": "http://192.168.100.1/api/v1/status",
            "headers": [
              {
                "name": "Cookie",
                "value": "PHPSESSID=abc123"
              }
            ],
            "cookies": [
              {
                "name": "PHPSESSID",
                "value": "abc123"
              }
            ]
          },
          "response": {
            "status": 200,
            "headers": []
          }
        }
      ]
    }
  },
