  "mid_session_duplicate_sources": {
    "_comment": "Same session cookie in both the cookies array and the Cookie header, plus a malformed header \u2014 names must dedupe to one, case-insensitively",
    "log": {
      "entries": [
        {
          "request": {
            "method": "GET",
            "url": "http://192.168.100.1/",
            "headers": [
              {
                "name": "Cookie",
                "value": "phpsessid=abc123; garbage; =novalue"
              },
              {
                "name": "Accept",
                "value": "*/*"
              }
            ],
            "cookies": [
              {
                "name": "PHPSESSID",
                "value": "abc123"
              },
              {
                "name": "",
                "value": "empty-name"
              }
            ]
          },
          "response": {
            "status": 200,
            "headers": []
          }
        }
      ]
    }
  },
  "cookie_probe_template": {
    "_comment": "Single-entry HAR for probing one cookie name at a time; tests substitute the Cookie header value. Carries a POST body so only the mid-session warning can fire.",
    "log": {
      "entries": [
        {
          "request": {
            "method": "POST",
            "url": "http://192.168.100.1/",
            "headers": [
              {
                "name": "Cookie",
                "value": "SUBSTITUTED_BY_TEST=v"
              }
            ],
            "postData": {
              "text": "a=1"
            }
          },
          "response": {
            "status": 200,
            "headers": []
          }
        }
      ]
    }
  },
