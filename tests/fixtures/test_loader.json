{
  "include_patterns_loader_cases": [
    {
      "domain_config": {"include_patterns": ["mac_address", "email"]},
      "expected_present": ["mac_address", "email"],
      "expected_absent": ["credit_card_visa", "ssn", "serial_number"],
      "exact_set": true,
      "id": "exact_names_keep_only_listed"
    },
    {
      "domain_config": {"include_patterns": ["credit_card_*"]},
      "expected_present": ["credit_card_visa", "credit_card_mastercard", "credit_card_amex"],
      "expected_absent": ["mac_address", "email"],
      "exact_set": false,
      "id": "wildcard_keeps_category"
    },
    {
      "domain_config": {"include_patterns": ["mac_address", "private_ip", "public_ip", "ipv6", "*_ip"]},
      "expected_present": ["mac_address", "private_ip", "public_ip", "ipv6"],
      "expected_absent": ["credit_card_visa", "ssn"],
      "exact_set": false,
      "id": "mixed_exact_and_wildcard"
    },
    {
      "domain_config": {"tagValueList": {"safe_values": ["foo"]}},
      "expected_present": ["credit_card_visa", "mac_address", "ssn"],
      "expected_absent": [],
      "exact_set": false,
      "id": "no_include_patterns_preserves_all"
    },
    {
      "domain_config": {
        "include_patterns": ["mac_address", "docsis_account"],
        "patterns": {
          "docsis_account": {
            "regex": "CM-ACCT-\\d{8,}",
            "replacement_prefix": "DOCSIS"
          }
        }
      },
      "expected_present": ["mac_address", "docsis_account"],
      "expected_absent": ["credit_card_visa", "ssn"],
      "exact_set": true,
      "id": "domain_custom_pattern_included"
    }
  ],

  "include_patterns_pii_cases": [
    {
      "domain_config": {"include_patterns": ["mac_address"]},
      "content": "MAC: DE:AD:BE:EF:CA:FE and card 4111111111111111",
      "expected_detected": ["mac_address"],
      "expected_not_detected": ["credit_card_visa"],
      "id": "only_included_patterns_detected"
    },
    {
      "domain_config": {
        "include_patterns": ["mac_address", "serial_number", "private_ip", "public_ip", "ipv6", "email"]
      },
      "content": "poll_duration: 2.343620812986046",
      "expected_detected": [],
      "expected_not_detected": [],
      "id": "cable_modem_false_positive_suppressed"
    }
  ],

  "merge_cases": {
    "_comment": "How a custom file extends the built-ins. loader: sensitive or allowlist. custom: the custom dict. expect: [path, kind, value] — kind contains (the list at path holds value), equals, or not_equals.",
    "cases": [
      {"id": "cookie_redact_extended",            "loader": "sensitive", "custom": {"headers": {"cookie_redact": ["X-Session"]}},             "expect": [[["headers", "cookie_redact"], "contains", "X-Session"]]},
      {"id": "detectors_without_safe_patterns",   "loader": "sensitive", "custom": {"heuristics": {"detectors": [{"category": "c"}]}},     "expect": [[["heuristics", "detectors"], "contains", {"category": "c"}]]},
      {"id": "format_preserving_key_added",       "loader": "allowlist", "custom": {"format_preserving_patterns": {"_comment": "custom", "vin": {"pattern": "^V", "description": "d"}}},
       "expect": [[["format_preserving_patterns", "vin"], "equals", {"pattern": "^V", "description": "d"}], [["format_preserving_patterns", "_comment"], "not_equals", "custom"]]}
    ]
  },

  "merge_files_cases": {
    "_comment": "merge_pattern_files over files written in order: a section only a later file has is taken whole; within a section lists extend, dicts update, other values are replaced, and _ keys are skipped.",
    "cases": [
      {"id": "no_files",                "files": [],                                                        "merged": {}},
      {"id": "section_only_in_later",   "files": [{}, {"headers": {"full_redact": ["A"]}}],                 "merged": {"headers": {"full_redact": ["A"]}}},
      {"id": "extend_update_replace",   "files": [{"tagValueList": {"safe_values": ["a"]}, "heuristics": {"x": {"a": 1}, "flag": 1}},
                                                  {"tagValueList": {"_comment": "c", "safe_values": ["b"]}, "heuristics": {"x": {"b": 2}, "flag": 2, "new": [1]}}],
                                        "merged": {"tagValueList": {"safe_values": ["a", "b"]}, "heuristics": {"x": {"a": 1, "b": 2}, "flag": 2, "new": [1]}}}
    ]
  },

  "detector_compile_cases": {
    "_comment": "compile_detectors compiles each detector pattern as compile_pattern does: an entry without a regex or with an invalid one is skipped, an unknown flag is ignored.",
    "cases": [
      {"id": "skips_and_flags", "patterns": [{"reason": "no regex"}, {"regex": "^a", "flags": ["NOPE"], "reason": "unknown flag"}, {"regex": "(", "reason": "invalid"}, {"regex": "^b", "flags": ["IGNORECASE"], "reason": "ignorecase"}],
       "compiled": [["unknown flag", "a", true], ["ignorecase", "B", true]]}
    ]
  },

  "list_domains_cases": {
    "_comment": "list_domains reads every *.json in the domains directory; a file that is not valid JSON is skipped, and a missing directory lists nothing.",
    "cases": [
      {"id": "invalid_file_skipped", "files": {"good_one.json": "{\"_description\": \"Good\"}", "broken.json": "{ nope"}, "names": ["good-one"]},
      {"id": "missing_directory",    "files": null,                                                                           "names": []}
    ]
  },

  "malformed_custom_cases": {
    "_comment": "A pattern file is user input: a section, list or entry of the wrong type is skipped with a warning, and the rest of the file still applies. Each row runs sanitize_html, check_for_pii and sanitize_har with the dict, and merge_pattern_files with network-device plus the dict as a second file; none may raise. The valid `fields` entry must still apply.",
    "cases": [
      {"id": "script_variables_list",       "custom": {"script_variables": []}},
      {"id": "heuristics_null",             "custom": {"heuristics": null}},
      {"id": "heuristics_number",           "custom": {"heuristics": 5}},
      {"id": "tag_value_list_null",         "custom": {"tagValueList": null}},
      {"id": "safe_values_number",          "custom": {"tagValueList": {"safe_values": 5}}},
      {"id": "detector_pattern_string",     "custom": {"heuristics": {"detectors": [{"category": "x", "patterns": ["^abc$"]}]}}},
      {"id": "detector_not_object",         "custom": {"heuristics": {"detectors": ["x"]}}},
      {"id": "detector_min_length_string",  "custom": {"heuristics": {"detectors": [{"category": "serial_number", "confidence": "high", "min_length": "13", "patterns": [{"regex": "^A"}]}]}}},
      {"id": "safe_value_pattern_string",   "custom": {"heuristics": {"safe_value_patterns": ["^ok$"]}}},
      {"id": "include_patterns_number",     "custom": {"include_patterns": [5, "mac_address"]}},
      {"id": "headers_list",                "custom": {"headers": ["cookie"]}},
      {"id": "full_redact_string",          "custom": {"headers": {"full_redact": "x-token"}}},
      {"id": "hash_prefixes_null",          "custom": {"hash_prefixes": null}},
      {"id": "format_preserving_list",      "custom": {"format_preserving_patterns": ["x"]}},
      {"id": "script_variables_kind_string", "custom": {"script_variables": {"password": "adminPw"}}},
      {"id": "format_preserving_pattern_number", "custom": {"format_preserving_patterns": {"vin": {"pattern": 5}}}},
      {"id": "safe_value_patterns_string",  "custom": {"heuristics": {"safe_value_patterns": "^ok$"}}},
      {"id": "detectors_string",            "custom": {"heuristics": {"detectors": "serial"}}},
      {"id": "detector_patterns_string",    "custom": {"heuristics": {"detectors": [{"category": "x", "patterns": "^abc$"}]}}},
      {"id": "bloat_extensions_string",     "custom": {"bloat_extensions": {"_comment": "kept", "images": "png"}}},
      {"id": "file_is_list",                "custom": []},
      {"id": "preserved_ips_string",        "custom": {"preserved_gateway_ips": "10.0.0.1"}}
    ]
  }
}
