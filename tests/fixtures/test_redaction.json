  "transport_body_cases": {
    "_comment": "decode_transport_body(content): the text a HAR response body carries. A body without 'encoding' is already text. A base64 body is decoded with the mime type's charset — or strict UTF-8 when none is declared or the declared one is unknown or not a text encoding. Bytes that do not decode are binary (None), except under a text mime type (is_text_mime), where undeclared non-UTF-8 bytes are read as latin-1: capture writes such a page base64 when it is not UTF-8, and browsers render undeclared pages in a Latin charset. Text holding NUL is binary.",
    "cases": [
      {"id": "plain_text_unchanged",                              "content": {"text": "<p>hi</p>", "mimeType": "text/html"},                                                             "expected": "<p>hi</p>"},
      {"id": "base64_utf8_json",                                  "content": {"text": "eyJtYWMiOiAiM0M6N0E6OEE6MTI6MzQ6NTYifQ==", "mimeType": "application/json", "encoding": "base64"}, "expected": "{\"mac\": \"3C:7A:8A:12:34:56\"}"},
      {"id": "base64_misspelled_mime",                            "content": {"text": "eyJhIjogMX0=", "mimeType": "applation/json", "encoding": "base64"},                               "expected": "{\"a\": 1}"},
      {"id": "base64_latin1_declared",                            "content": {"text": "Y2Fm6Q==", "mimeType": "text/html; charset=ISO-8859-1", "encoding": "base64"},                    "expected": "café"},
      {"id": "base64_latin1_undeclared_text_mime_read_as_latin1", "content": {"text": "Y2Fm6Q==", "mimeType": "text/html", "encoding": "base64"},                                        "expected": "café"},
      {"id": "base64_unknown_charset_falls_back_to_utf8",         "content": {"text": "b2s=", "mimeType": "text/plain; charset=x-nonsense", "encoding": "base64"},                       "expected": "ok"},
      {"id": "woff2_binary",                                      "content": {"text": "d09GMgABAAAAABI0//4=", "mimeType": "font/woff2", "encoding": "base64"},                           "expected": null},
      {"id": "ascii_with_nul_is_binary",                          "content": {"text": "YWIAY2Q=", "mimeType": "application/octet-stream", "encoding": "base64"},                         "expected": null},
      {"id": "invalid_base64",                                    "content": {"text": "not base64!!", "mimeType": "text/plain", "encoding": "base64"},                                   "expected": null},
      {"id": "missing_text",                                      "content": {"mimeType": "text/html"},                                                                                  "expected": null},
      {"id": "empty_text",                                        "content": {"text": "", "mimeType": "text/html"},                                                                      "expected": null},
      {"id": "non_text_codec_hex_falls_back_to_utf8",             "content": {"text": "b2s=", "mimeType": "text/plain; charset=hex", "encoding": "base64"},                              "expected": "ok"},
      {"id": "non_text_codec_zlib_falls_back_to_utf8",            "content": {"text": "b2s=", "mimeType": "text/plain; charset=zlib", "encoding": "base64"},                             "expected": "ok"},
      {"id": "declared_charset_mismatch_text_mime_latin1",                      "content": {"text": "//4=", "mimeType": "text/plain; charset=punycode", "encoding": "base64"},                         "expected": "\u00ff\u00fe"},
      {"id": "declared_charset_mismatch_octet_stream_binary", "content": {"text": "//4=", "mimeType": "application/octet-stream; charset=utf-8", "encoding": "base64"}, "expected": null},
      {"id": "whitespace_only_base64",                            "content": {"text": "   ", "mimeType": "text/plain", "encoding": "base64"},                                            "expected": null},
      {"id": "line_wrapped_base64",                               "content": {"text": "b2sg\nb2s=", "mimeType": "text/plain", "encoding": "base64"},                                     "expected": "ok ok"},
      {"id": "nul_in_charset_falls_back_to_utf8",                 "content": {"text": "b2s=", "mimeType": "text/plain; charset=utf\u0000-8", "encoding": "base64"},                      "expected": "ok"},
      {"id": "base64_latin1_undeclared_octet_stream_is_binary",   "content": {"text": "Y2Fm6Q==", "mimeType": "application/octet-stream", "encoding": "base64"},                         "expected": null},
      {"id": "base64_latin1_undeclared_misspelled_json_mime",     "content": {"text": "eyJhIjogImNhZukifQ==", "mimeType": "applation/json", "encoding": "base64"},                       "expected": "{\"a\": \"café\"}"}
    ]
  },
  "base64_payload_cases": {
    "_comment": "decode_base64_payload(value): the text of a base64-wrapped structured payload — a JSON object or array, or a URL — whose colon would otherwise read as user:pass. Padding may be missing or excess (URLs strip and miscount it). A JSON scalar, colon text, non-UTF-8 bytes, and anything not base64 are not payloads.",
    "cases": [
      {"id": "json_object",            "value": "eyJhIjogMSwgImIiOiB7ImMiOiAyfX0=",         "expected": "{\"a\": 1, \"b\": {\"c\": 2}}"},
      {"id": "json_array",             "value": "W3sieCI6IDF9LCB7InkiOiAyfV0=",             "expected": "[{\"x\": 1}, {\"y\": 2}]"},
      {"id": "json_object_unpadded",   "value": "eyJhIjogMX0",                              "expected": "{\"a\": 1}"},
      {"id": "url",                    "value": "aHR0cDovLzE5Mi4xNjguMTAwLjEvbG9naW4/eD0x", "expected": "http://192.168.100.1/login?x=1"},
      {"id": "surrounding_whitespace", "value": " eyJhIjogMX0=\n",                          "expected": "{\"a\": 1}"},
      {"id": "json_scalar_number",     "value": "NDI=",                                     "expected": null},
      {"id": "json_scalar_string",     "value": "Imp1c3QtYS1zdHJpbmci",                     "expected": null},
      {"id": "brace_but_not_json",     "value": "e25vdCBqc29uOiAx",                         "expected": null},
      {"id": "user_pass_credential",   "value": "YWRtaW46cGFzc3dvcmQ=",                     "expected": null},
      {"id": "non_utf8_bytes",         "value": "//76+w==",                                 "expected": null},
      {"id": "plain_json_not_base64",  "value": "{\"a\": 1}",                               "expected": null},
      {"id": "html_not_base64",        "value": "<html></html>",                            "expected": null},
      {"id": "empty",                  "value": "",                                         "expected": null}
    ]
  },
  "text_mime_cases": {
    "_comment": "mime_kind(mime): what a mime type declares its body to be — markup (HTML, XML, any +xml), json (any json subtype or +json, whatever the type: DM1000's applation/json), text (other text/*, JavaScript, form data), or null when the type says nothing about text. is_text_mime is kind != null. Parameters and case are ignored; a subtype merely containing 'json' or 'xml' is not one.",
    "cases": [
      {"id": "text_html",                  "mime": "text/html; charset=utf-8",                                                "kind": "markup"},
      {"id": "text_plain",                 "mime": "TEXT/PLAIN",                                                              "kind": "text"},
      {"id": "application_json",           "mime": "application/json",                                                        "kind": "json"},
      {"id": "misspelled_json",            "mime": "applation/json",                                                          "kind": "json"},
      {"id": "problem_json_suffix",        "mime": "application/problem+json",                                                "kind": "json"},
      {"id": "application_xml",            "mime": "application/xml",                                                         "kind": "markup"},
      {"id": "svg_xml_suffix",             "mime": "image/svg+xml",                                                           "kind": "markup"},
      {"id": "application_javascript",     "mime": "application/javascript",                                                  "kind": "text"},
      {"id": "application_x_javascript",   "mime": "application/x-javascript",                                                "kind": "text"},
      {"id": "form_urlencoded",            "mime": "application/x-www-form-urlencoded",                                       "kind": "text"},
      {"id": "octet_stream",               "mime": "application/octet-stream",                                                "kind": null},
      {"id": "hnap_x_unknown",             "mime": "x-unknown",                                                               "kind": null},
      {"id": "woff2",                      "mime": "font/woff2",                                                              "kind": null},
      {"id": "png",                        "mime": "image/png",                                                               "kind": null},
      {"id": "empty",                      "mime": "",                                                                        "kind": null},
      {"id": "jsonlines_ish_not_subtype",  "mime": "application/jsonlines-ish",                                               "kind": null},
      {"id": "office_document_is_not_xml", "mime": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "kind": null},
      {"id": "xhtml",                      "mime": "application/xhtml+xml",                                                   "kind": "markup"},
      {"id": "text_css",                   "mime": "text/css",                                                                "kind": "text"}
    ]
  },
  "json_container_cases": {
    "_comment": "parse_json_container(text): a JSON object or array, or null. Scalars, invalid JSON and nesting too deep for the parser are not containers — hostile nesting must not crash either tool. 'nesting' builds '[' * n + ']' * n instead of a literal text.",
    "cases": [
      {"id": "object",             "text": "{\"a\": 1}",     "is_container": true},
      {"id": "array",              "text": "[1, 2]",         "is_container": true},
      {"id": "leading_whitespace", "text": " \n {\"a\": 1}", "is_container": true},
      {"id": "scalar_number",      "text": "42",             "is_container": false},
      {"id": "scalar_string",      "text": "\"a\"",          "is_container": false},
      {"id": "invalid",            "text": "{not json",      "is_container": false},
      {"id": "empty",              "text": "",               "is_container": false},
      {"id": "moderate_nesting",   "is_container": true,  "nesting": 100},
      {"id": "hostile_nesting",    "is_container": false, "nesting": 20000}
    ]
  },
  "constant_mac_cases": {
    "_comment": "is_constant_mac(mac): one byte repeated — broadcast, zero — in any layout. Protocol constants, not identities: neither tool treats them as PII.",
    "cases": [
      {"id": "broadcast",             "mac": "ff:ff:ff:ff:ff:ff", "constant": true},
      {"id": "zero_hyphen",           "mac": "00-00-00-00-00-00", "constant": true},
      {"id": "repeated_upper",        "mac": "AA:AA:AA:AA:AA:AA", "constant": true},
      {"id": "bare_zero",             "mac": "000000000000",      "constant": true},
      {"id": "device_mac",            "mac": "3C:7A:8A:12:34:56", "constant": false},
      {"id": "two_bytes_alternating", "mac": "ab:ab:ab:ab:ab:ac", "constant": false},
      {"id": "not_a_mac",             "mac": "ff:ff",             "constant": false}
    ]
  },
  "query_payload_cases": {
    "_comment": "find_query_payload(segment): a base64-wrapped JSON or URL payload in one raw query segment. prefix is kept verbatim; encoded is the base64 with URL transport encoding undone; quoted records that the segment percent-encoded it. Credentials and non-payloads give null.",
    "cases": [
      {"id": "bare",                        "segment": "eyJwYXNzd29yZCI6Imh1bnRlcjJodW50ZXIyIiwicGFnZSI6MX0=",        "prefix": "",      "encoded": "eyJwYXNzd29yZCI6Imh1bnRlcjJodW50ZXIyIiwicGFnZSI6MX0=", "quoted": false},
      {"id": "keyed",                       "segment": "data=eyJwYXNzd29yZCI6Imh1bnRlcjJodW50ZXIyIiwicGFnZSI6MX0=",   "prefix": "data=", "encoded": "eyJwYXNzd29yZCI6Imh1bnRlcjJodW50ZXIyIiwicGFnZSI6MX0=", "quoted": false},
      {"id": "keyed_unpadded",              "segment": "data=eyJwYXNzd29yZCI6Imh1bnRlcjJodW50ZXIyIiwicGFnZSI6MX0",    "prefix": "data=", "encoded": "eyJwYXNzd29yZCI6Imh1bnRlcjJodW50ZXIyIiwicGFnZSI6MX0",  "quoted": false},
      {"id": "percent_encoded_padding",     "segment": "data=eyJwYXNzd29yZCI6Imh1bnRlcjJodW50ZXIyIiwicGFnZSI6MX0%3D", "prefix": "data=", "encoded": "eyJwYXNzd29yZCI6Imh1bnRlcjJodW50ZXIyIiwicGFnZSI6MX0=", "quoted": true},
      {"id": "space_for_plus",              "segment": "data=eyJrIjoifn5 PiJ9",                                       "prefix": "data=", "encoded": "eyJrIjoifn5+PiJ9",                                     "quoted": false},
      {"id": "doubled_question_mark",       "segment": "?eyJwYXNzd29yZCI6Imh1bnRlcjJodW50ZXIyIiwicGFnZSI6MX0=",       "prefix": "?",     "encoded": "eyJwYXNzd29yZCI6Imh1bnRlcjJodW50ZXIyIiwicGFnZSI6MX0=", "quoted": false},
      {"id": "doubled_equals",              "segment": "k==eyJwYXNzd29yZCI6Imh1bnRlcjJodW50ZXIyIiwicGFnZSI6MX0=",     "prefix": "k==",   "encoded": "eyJwYXNzd29yZCI6Imh1bnRlcjJodW50ZXIyIiwicGFnZSI6MX0=", "quoted": false},
      {"id": "credential_is_not_a_payload", "segment": "YWRtaW46cGFzc3dvcmQ=",                                        "prefix": null,    "encoded": null,                                                   "quoted": null},
      {"id": "plain_value",                 "segment": "page=2",                                                      "prefix": null,    "encoded": null,                                                   "quoted": null},
      {"id": "empty",                       "segment": "",                                                            "prefix": null,    "encoded": null,                                                   "quoted": null}
    ]
  }
}
