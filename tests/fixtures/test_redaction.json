  "base64_credential_padding_cases": {
    "_comment": "is_base64_credential requires canonical padding on every supported Python. 3.10's b64decode(validate=True) accepts excess padding that 3.11+ rejects; the result must not depend on the interpreter.",
    "cases": [
      {"id": "canonical_one_pad",  "value": "YWRtaW46cGFzc3dvcmQ=",   "expected": true},
      {"id": "canonical_no_pad",   "value": "YWRtaW46cGFzcw==",       "expected": true},
      {"id": "excess_padding",     "value": "YWRtaW46cGFzc3dvcmQ==",  "expected": false},
      {"id": "missing_padding",    "value": "YWRtaW46cGFzc3dvcmQ",    "expected": false},
      {"id": "padding_on_full_quantum", "value": "YWRtaW46cGFzcw===", "expected": false}
    ]
  },
  "query_credential_cases": {
    "_comment": "find_query_credential(segment) over one raw URL query segment. prefix is the verbatim text kept ahead of the credential; credential is the base64(user:pass) as the client produced it. The space_for_plus row is the shape URLSearchParams hands Playwright's queryString array: '+' decoded to a space.",
    "cases": [
      {"id": "bare_padded",              "segment": "YWRtaW46ZXhhbXBsZS1wdw==",               "prefix": "",       "credential": "YWRtaW46ZXhhbXBsZS1wdw==", "keyed": false},
      {"id": "bare_unpadded",            "segment": "YWRtaW46ZXhhbXBsZS1wdw",                 "prefix": "",       "credential": "YWRtaW46ZXhhbXBsZS1wdw==", "keyed": false},
      {"id": "keyed_padded",             "segment": "auth=YWRtaW46ZXhhbXBsZS1wdw==",          "prefix": "auth=",  "credential": "YWRtaW46ZXhhbXBsZS1wdw==", "keyed": true},
      {"id": "keyed_raw_plus",           "segment": "auth=YWRtaW46YWRtaW4+cGFzcw==",          "prefix": "auth=",  "credential": "YWRtaW46YWRtaW4+cGFzcw==", "keyed": true},
      {"id": "keyed_percent_padding",    "segment": "auth=YWRtaW46ZXhhbXBsZS1wdw%3D%3D",      "prefix": "auth=",  "credential": "YWRtaW46ZXhhbXBsZS1wdw==", "keyed": true},
      {"id": "prefixed_padded",          "segment": "login_YWRtaW46ZXhhbXBsZS1wdw==",         "prefix": "login_", "credential": "YWRtaW46ZXhhbXBsZS1wdw==", "keyed": false},
      {"id": "prefixed_percent_padding", "segment": "login_YWRtaW46ZXhhbXBsZS1wdw%3D%3D",     "prefix": "login_", "credential": "YWRtaW46ZXhhbXBsZS1wdw==", "keyed": false},
      {"id": "prefixed_plus_and_slash",  "segment": "login_YWRtaW46ZmFrZX5+cHc/",             "prefix": "login_", "credential": "YWRtaW46ZmFrZX5+cHc/",     "keyed": false},
      {"id": "prefixed_space_for_plus",  "segment": "login_YWRtaW46ZmFrZX5 cHc/",             "prefix": "login_", "credential": "YWRtaW46ZmFrZX5+cHc/",     "keyed": false},
      {"id": "keyed_percent_plus",       "segment": "auth=YWRtaW46YWRtaW4%2BcGFzcw%3D%3D",    "prefix": "auth=",  "credential": "YWRtaW46YWRtaW4+cGFzcw==", "keyed": true},
      {"id": "keyed_empty_name",         "segment": "=YWRtaW46ZXhhbXBsZS1wdw==",              "prefix": "=",      "credential": "YWRtaW46ZXhhbXBsZS1wdw==", "keyed": true},
      {"id": "marker_and_key_keyed_wins", "segment": "login_x=YWRtaW46ZXhhbXBsZS1wdw==",      "prefix": "login_x=", "credential": "YWRtaW46ZXhhbXBsZS1wdw==", "keyed": true},
      {"id": "uppercase_marker",         "segment": "LOGIN_YWRtaW46ZXhhbXBsZS1wdw==",         "prefix": "LOGIN_", "credential": "YWRtaW46ZXhhbXBsZS1wdw==", "keyed": false},
      {"id": "stripped_padding_short",   "segment": "YWRtaW46cHc",                            "prefix": "",       "credential": "YWRtaW46cHc=",             "keyed": false},
      {"id": "stripped_padding_too_short", "segment": "YTpiYw",                               "prefix": null,     "credential": null,                       "keyed": null},
      {"id": "hex_cache_buster",         "segment": "v=0406a0",                               "prefix": null,     "credential": null,                       "keyed": null},
      {"id": "sanitizer_placeholder",    "segment": "AUTH_d2c6b8e4",                          "prefix": null,     "credential": null,                       "keyed": null},
      {"id": "excess_padding_canonicalized", "segment": "login_YWRtaW46cGFzc3dvcmQ==",        "prefix": "login_", "credential": "YWRtaW46cGFzc3dvcmQ=",     "keyed": false},
      {"id": "placeholder_shaped_marker_credential", "segment": "AUTH_YWRtaW46U3VwM3JTZWNyZXQx", "prefix": "AUTH_", "credential": "YWRtaW46U3VwM3JTZWNyZXQx", "keyed": false},
      {"id": "doubled_question_mark",    "segment": "?YWRtaW46ZXhhbXBsZS1wdw==",              "prefix": "?",      "credential": "YWRtaW46ZXhhbXBsZS1wdw==", "keyed": false},
      {"id": "doubled_equals",           "segment": "k==YWRtaW46ZXhhbXBsZS1wdw==",            "prefix": "k==",    "credential": "YWRtaW46ZXhhbXBsZS1wdw==", "keyed": true},
      {"id": "padded_base64_json_redacted_as_before", "segment": "q=eyJwYWdlIjoxLCJzb3J0IjoyfQ==", "prefix": "q=", "credential": "eyJwYWdlIjoxLCJzb3J0IjoyfQ==", "keyed": true},
      {"id": "unpadded_base64_url",      "segment": "state=aHR0cDovLzE5Mi4xNjguMTAwLjEvaW5kZXguaHRtbA", "prefix": null, "credential": null,             "keyed": null},
      {"id": "unpadded_base64_json",     "segment": "q=eyJwYWdlIjoxLCJzb3J0IjoyfQ",           "prefix": null,     "credential": null,                       "keyed": null},
      {"id": "multi_underscore_marker",  "segment": "a_login_YWRtaW46ZXhhbXBsZS1wdw==",       "prefix": null,     "credential": null,                       "keyed": null},
      {"id": "keyed_empty_value",        "segment": "password=",                              "prefix": null,     "credential": null,                       "keyed": null},
      {"id": "prefixed_opaque_token",    "segment": "ct_c2Vzc2lvbmlkMTIzNDU2",                "prefix": null,     "credential": null,                       "keyed": null},
      {"id": "prefixed_placeholder",     "segment": "login_AUTH_1a2b3c4d",                    "prefix": null,     "credential": null,                       "keyed": null},
      {"id": "plain_param",              "segment": "id=123",                                 "prefix": null,     "credential": null,                       "keyed": null},
      {"id": "search_query",             "segment": "q=hello+world",                          "prefix": null,     "credential": null,                       "keyed": null},
      {"id": "bare_base64_no_colon",     "segment": "aGVsbG8gd29ybGQ=",                       "prefix": null,     "credential": null,                       "keyed": null},
      {"id": "empty_segment",            "segment": "",                                       "prefix": null,     "credential": null,                       "keyed": null}
    ]
  },
  "mac_regex_cases": {
    "_comment": "MAC_RE over free text: matches are the MAC substrings found, in order. A MAC is bounded by non-hex characters on both sides, so one glued to a letter outside a-f or to '_' is still a MAC, while one glued to a hex digit is part of a longer run and is not. Bare 12-hex is not matched here: without a label it cannot be told from any other hex run.",
    "cases": [
      {"id": "colon_standalone",          "text": "mac 3C:7A:8A:12:34:56 end",           "matches": ["3C:7A:8A:12:34:56"]},
      {"id": "hyphen_lowercase",          "text": "3c-7a-8a-12-34-56",                   "matches": ["3c-7a-8a-12-34-56"]},
      {"id": "quoted_json_value",         "text": "\"3C:7A:8A:12:34:56\"",               "matches": ["3C:7A:8A:12:34:56"]},
      {"id": "glued_to_underscore",       "text": "cm_mac_3C:7A:8A:12:34:56",            "matches": ["3C:7A:8A:12:34:56"]},
      {"id": "glued_to_non_hex_letter",   "text": "HWaddr3C:7A:8A:12:34:56",             "matches": ["3C:7A:8A:12:34:56"]},
      {"id": "glued_to_hex_digit_before", "text": "13C:7A:8A:12:34:56",                  "matches": []},
      {"id": "glued_to_hex_letter_after", "text": "3C:7A:8A:12:34:56A",                  "matches": []},
      {"id": "seven_groups_first_six",    "text": "3C:7A:8A:12:34:56:78",                "matches": ["3C:7A:8A:12:34:56"]},
      {"id": "bare_twelve_hex",           "text": "3C7A8A123456",                        "matches": []},
      {"id": "clock_time",                "text": "uptime 12:34:56",                     "matches": []},
      {"id": "ipv6_compressed",           "text": "fe80::3c7a:8aff:fe12:3456",           "matches": []},
      {"id": "two_macs",                  "text": "3C:7A:8A:12:34:56,3C:7A:8A:12:34:57", "matches": ["3C:7A:8A:12:34:56", "3C:7A:8A:12:34:57"]}
    ]
  },
  "url_credential_cases": {
    "_comment": "iter_url_credentials(request): every base64(user:pass) credential in a request's query, as find_query_credential reads it: the URL string's segments first, then the queryString array (so a credential recorded in both appears twice). The query is read by splitting at '?' and '#', so a URL urlparse rejects (an unbalanced IPv6 bracket) is still read. Malformed requests yield nothing.",
    "cases": [
      {"id": "bare_in_url",                    "request": {"url": "https://d.local/login?YWRtaW46cGFzcw==", "queryString": []},                                         "credentials": ["YWRtaW46cGFzcw=="]},
      {"id": "keyed_in_url",                   "request": {"url": "https://d.local/login?token=YWRtaW46cGFzcw==", "queryString": []},                                   "credentials": ["YWRtaW46cGFzcw=="]},
      {"id": "marker_in_url",                  "request": {"url": "https://d.local/status.html?login_YWRtaW46cGFzcw==", "queryString": []},                             "credentials": ["YWRtaW46cGFzcw=="]},
      {"id": "keyed_percent_encoded",          "request": {"url": "https://d.local/login?auth=YWRtaW46cGFzcw%3D%3D"},                                                   "credentials": ["YWRtaW46cGFzcw=="]},
      {"id": "url_and_array_both_reported",    "request": {"url": "https://d.local/login?YWRtaW46cGFzcw==", "queryString": [{"name": "YWRtaW46cGFzcw", "value": "="}]}, "credentials": ["YWRtaW46cGFzcw==", "YWRtaW46cGFzcw=="]},
      {"id": "marker_split_by_query_parser",   "request": {"url": "", "queryString": [{"name": "login_YWRtaW46cGFzcw", "value": "="}]},                                 "credentials": ["YWRtaW46cGFzcw=="]},
      {"id": "credential_as_array_value",      "request": {"url": "", "queryString": [{"name": "token", "value": "YWRtaW46cGFzcw=="}]},                                 "credentials": ["YWRtaW46cGFzcw=="]},
      {"id": "credential_as_array_name",       "request": {"url": "", "queryString": [{"name": "YWRtaW46cGFzcw==", "value": ""}]},                                      "credentials": ["YWRtaW46cGFzcw=="]},
      {"id": "unbalanced_ipv6_bracket",        "request": {"url": "http://[::1/login?YWRtaW46cGFzcw=="},                                                                "credentials": ["YWRtaW46cGFzcw=="]},
      {"id": "credential_in_fragment_ignored", "request": {"url": "https://d.local/login#YWRtaW46cGFzcw=="},                                                            "credentials": []},
      {"id": "no_query",                       "request": {"url": "https://d.local/status", "queryString": []},                                                         "credentials": []},
      {"id": "bare_non_credential_segment",    "request": {"url": "https://d.local/page?debug", "queryString": []},                                                     "credentials": []},
      {"id": "key_value_non_credential",       "request": {"url": "https://d.local/page?format=json", "queryString": []},                                               "credentials": []},
      {"id": "placeholder_not_credential",     "request": {"url": "https://d.local/page?login_AUTH_d2c6b8e4"},                                                          "credentials": []},
      {"id": "non_string_url",                 "request": {"url": 9000, "queryString": []},                                                                             "credentials": []},
      {"id": "array_not_a_list",               "request": {"url": "https://d.local/page", "queryString": null},                                                         "credentials": []},
      {"id": "array_entry_not_an_object",      "request": {"url": "", "queryString": ["not-a-dict", {"name": "YWRtaW46cGFzcw==", "value": ""}]},                        "credentials": ["YWRtaW46cGFzcw=="]},
      {"id": "empty_name_empty_value",         "request": {"url": "", "queryString": [{"name": "format", "value": ""}]},                                                "credentials": []},
      {"id": "empty_request",                  "request": {},                                                                                                           "credentials": []}
    ]
  },
  "json_identity_key_cases": {
    "_comment": "classify_identity_field(key, value): a key that names a serial or MAC, holding a value of that identity's shape. Keys are split into words (camelCase, acronyms, separators); the identity word must end the key. Shape only: whether the value is already a placeholder is the caller's decision. Serial values are one whitespace-free token of 5+ characters with a digit (every real serial across the fleet carries one; the digit-free values are placeholders like '-'). MAC values are any MAC form: separated, bare 12-hex, or dotted.",
    "cases": [
      {"id": "hnap_status_software_serial", "key": "StatusSoftwareSerialNum",          "value": "ABC123DEF456",      "category": "serial_number"},
      {"id": "bare_hex_mac_camel_key",      "key": "CmMacAddress",                     "value": "3C7A8A123456",      "category": "mac_address"},
      {"id": "all_digit_serial",            "key": "serialnumber",                     "value": "123456789012345",   "category": "serial_number"},
      {"id": "exact_sn",                    "key": "sn",                               "value": "TEST12345",         "category": "serial_number"},
      {"id": "suffix_serial",               "key": "deviceSerial",                     "value": "X1Y2Z3W4",          "category": "serial_number"},
      {"id": "serial_no",                   "key": "SerialNo",                         "value": "SN-00012345",       "category": "serial_number"},
      {"id": "screaming_serial_number",     "key": "SYSTEM_SERIAL_NUMBER",             "value": "4106844207105213",  "category": "serial_number"},
      {"id": "acronym_mac_addr",            "key": "wanMACAddr",                       "value": "3c:7a:8a:12:34:56", "category": "mac_address"},
      {"id": "numbered_mac_key",            "key": "macaddress_5",                     "value": "3C-7A-8A-12-34-56", "category": "mac_address"},
      {"id": "dotted_mac_hw_addr",          "key": "hw_addr",                          "value": "3c7a.8a12.3456",    "category": "mac_address"},
      {"id": "exact_mac",                   "key": "mac",                              "value": "3c:7a:8a:12:34:56", "category": "mac_address"},
      {"id": "i18n_label_no_digit",         "key": "PAGE_STATUS_SYSTEM_SERIAL_NUMBER", "value": "Seriennummer",      "category": null},
      {"id": "hmac_is_not_mac",             "key": "hmac_algorithm",                   "value": "3C7A8A123456",      "category": null},
      {"id": "ofdma_is_not_mac",            "key": "ofdmachannel",                     "value": "3C7A8A123456",      "category": null},
      {"id": "mac_filter_flag",             "key": "MacAddressFilterEnabled",          "value": "true",              "category": null},
      {"id": "dash_placeholder",            "key": "serialNumber",                     "value": "-",                 "category": null},
      {"id": "status_word",                 "key": "serialNumber",                     "value": "N/A",               "category": null},
      {"id": "serial_port",                 "key": "serialPort",                       "value": "ttyS0",             "category": null},
      {"id": "serial_number_label_key",     "key": "serialNumberLabel",                "value": "S/N 1234",          "category": null},
      {"id": "serial_with_space",           "key": "serial",                           "value": "SN 12345",          "category": null},
      {"id": "short_flag",                  "key": "serial",                           "value": "1",                 "category": null},
      {"id": "snr_is_not_sn",               "key": "snr",                              "value": "38.5dB",            "category": null},
      {"id": "mac_status_word",             "key": "mac",                              "value": "Enabled",           "category": null},
      {"id": "non_string_value",            "key": "serialNumber",                     "value": 12345678,            "category": null}
    ]
  },
  "transport_body_cases": {
    "_comment": "decode_transport_body(content): the text a HAR response body carries. A body without 'encoding' is already text. A base64 body is decoded with the mime type's charset, else strict UTF-8; bytes that do not decode, or decode to text holding NUL, are binary and give None.",
    "cases": [
      {"id": "plain_text_unchanged",                      "content": {"text": "<p>hi</p>", "mimeType": "text/html"},                                                             "expected": "<p>hi</p>"},
      {"id": "base64_utf8_json",                          "content": {"text": "eyJtYWMiOiAiM0M6N0E6OEE6MTI6MzQ6NTYifQ==", "mimeType": "application/json", "encoding": "base64"}, "expected": "{\"mac\": \"3C:7A:8A:12:34:56\"}"},
      {"id": "base64_misspelled_mime",                    "content": {"text": "eyJhIjogMX0=", "mimeType": "applation/json", "encoding": "base64"},                               "expected": "{\"a\": 1}"},
      {"id": "base64_latin1_declared",                    "content": {"text": "Y2Fm6Q==", "mimeType": "text/html; charset=ISO-8859-1", "encoding": "base64"},                    "expected": "café"},
      {"id": "base64_latin1_undeclared_is_binary",        "content": {"text": "Y2Fm6Q==", "mimeType": "text/html", "encoding": "base64"},                                        "expected": null},
      {"id": "base64_unknown_charset_falls_back_to_utf8", "content": {"text": "b2s=", "mimeType": "text/plain; charset=x-nonsense", "encoding": "base64"},                       "expected": "ok"},
      {"id": "woff2_binary",                              "content": {"text": "d09GMgABAAAAABI0//4=", "mimeType": "font/woff2", "encoding": "base64"},                           "expected": null},
      {"id": "ascii_with_nul_is_binary",                  "content": {"text": "YWIAY2Q=", "mimeType": "application/octet-stream", "encoding": "base64"},                         "expected": null},
      {"id": "invalid_base64",                            "content": {"text": "not base64!!", "mimeType": "text/plain", "encoding": "base64"},                                   "expected": null},
      {"id": "missing_text",                              "content": {"mimeType": "text/html"},                                                                                  "expected": null},
      {"id": "empty_text",                                "content": {"text": "", "mimeType": "text/html"},                                                                      "expected": null}
    ]
  }
}
