{
  "_comment": "Hasher fixtures: salt modes, and each hash method's output format and correlation.",
  "create_cases": {
    "_comment": "Hasher.create(salt): 'auto'/'random' mint a 32-hex salt; None selects static placeholders; any other string is used as given.",
    "cases": [
      {"id": "auto_generates_random_salt", "salt": "auto",    "expected": "random_hex"},
      {"id": "random_is_alias_for_auto",   "salt": "random",  "expected": "random_hex"},
      {"id": "none_selects_static_mode",   "salt": null,      "expected": null},
      {"id": "custom_salt_preserved",      "salt": "my-salt", "expected": "my-salt"},
      {"id": "empty_string_is_a_salt",     "salt": "",        "expected": ""}
    ]
  },
  "hash_mac_format_cases": {
    "_comment": "hash_mac keeps the input's layout: separator and grouping survive, the first octet becomes the locally administered 02, hex is lowercase. A value in no MAC layout gets the colon form.",
    "cases": [
      {"id": "colon_upper",      "input": "3C:7A:8A:12:34:56", "output_re": "^02(:[0-9a-f]{2}){5}$"},
      {"id": "colon_lower",      "input": "3c:7a:8a:12:34:56", "output_re": "^02(:[0-9a-f]{2}){5}$"},
      {"id": "hyphen",           "input": "3C-7A-8A-12-34-56", "output_re": "^02(-[0-9a-f]{2}){5}$"},
      {"id": "bare_upper",       "input": "3C7A8A123456",      "output_re": "^02[0-9a-f]{10}$"},
      {"id": "bare_lower",       "input": "3c7a8a123456",      "output_re": "^02[0-9a-f]{10}$"},
      {"id": "dotted",           "input": "3c7a.8a12.3456",    "output_re": "^02[0-9a-f]{2}\\.[0-9a-f]{4}\\.[0-9a-f]{4}$"},
      {"id": "mixed_separators", "input": "3C:7A-8A:12-34:56", "output_re": "^02(:[0-9a-f]{2}){5}$"},
      {"id": "not_a_mac_layout", "input": "N/A",               "output_re": "^02(:[0-9a-f]{2}){5}$"}
    ]
  },
  "hash_mac_normalization_cases": {
    "_comment": "Every layout of one MAC hashes to the same digits, so correlation survives a device writing the same MAC two ways. Separators and case are not part of the identity.",
    "cases": [
      {"id": "one_mac_every_layout", "inputs": ["3C:7A:8A:12:34:56", "3c:7a:8a:12:34:56", "3C-7A-8A-12-34-56", "3C7A8A123456", "3c7a.8a12.3456"]},
      {"id": "mixed_separators",     "inputs": ["3C:7A-8A:12-34:56", "3C:7A:8A:12:34:56"]}
    ]
  },
  "hash_mac_stable_cases": {
    "_comment": "A fixed salt gives a colon or hyphen MAC the same digits every release: the digest is taken over the uppercase colon form, as before 0.13.0. The expected values are what 0.12.6 wrote for the colon input.",
    "cases": [
      {"id": "colon_input_matches_0_12", "salt": "fixed", "input": "AA:BB:CC:DD:EE:FF", "expected": "02:df:f0:2a:db:05"},
      {"id": "hyphen_input_same_digits", "salt": "fixed", "input": "aa-bb-cc-dd-ee-ff", "expected": "02-df-f0-2a-db-05"},
      {"id": "bare_input_same_digits",   "salt": "fixed", "input": "AABBCCDDEEFF",      "expected": "02dff02adb05"}
    ]
  },
  "hash_ip_cases": {
    "_comment": "hash_ip keeps IPv4 form in a reserved range: private → 10.255.x.x, public → 192.0.2.x.",
    "cases": [
      {"id": "private_192_168",   "ip": "192.168.1.1", "is_private": true,  "prefix": "10.255."},
      {"id": "private_10",        "ip": "10.0.0.1",    "is_private": true,  "prefix": "10.255."},
      {"id": "private_172_16",    "ip": "172.16.0.1",  "is_private": true,  "prefix": "10.255."},
      {"id": "public_google_dns", "ip": "8.8.8.8",     "is_private": false, "prefix": "192.0.2."},
      {"id": "public_cloudflare", "ip": "1.1.1.1",     "is_private": false, "prefix": "192.0.2."}
    ]
  },
  "hash_ipv6_cases": {
    "_comment": "hash_ipv6 writes into the 2001:db8::/32 documentation prefix.",
    "cases": [
      {"id": "link_local",   "ip": "fe80::1"},
      {"id": "google_dns",   "ip": "2001:4860:4860::8888"},
      {"id": "localhost",    "ip": "::1"},
      {"id": "unique_local", "ip": "fd00::1234:5678"}
    ]
  },
  "hash_email_cases": {
    "_comment": "hash_email writes user_<hash>@redacted.invalid.",
    "cases": [
      {"id": "standard",             "email": "user@example.com"},
      {"id": "uppercase",            "email": "USER@EXAMPLE.COM"},
      {"id": "plus_tag_multi_label", "email": "test.user+tag@domain.co.uk"},
      {"id": "minimal",              "email": "a@b.c"}
    ]
  },
  "stand_in_cases": {
    "_comment": "With preserve_length, every hasher method writes a stand-in of the value's UTF-8 byte length and character classes (SANITIZATION_SPEC 'Length-Preserving Stand-ins'). salted_re is what a salted stand-in must match; static is the exact fill written without a salt. method: mac, private_ip, public_ip, ipv6, email, or value (hash_value with prefix).",
    "cases": [
      {
        "id": "mac_colon_upper",
        "method": "mac",
        "input": "A4:2B:B0:C1:D2:E3",
        "salted_re": "^02(:[0-9A-F]{2}){5}$",
        "static": "XX:XX:XX:XX:XX:XX"
      },
      {
        "id": "mac_bare_lower",
        "method": "mac",
        "input": "a42bb0c1d2e3",
        "salted_re": "^02[0-9a-f]{10}$",
        "static": "XXXXXXXXXXXX"
      },
      {
        "id": "mac_dotted",
        "method": "mac",
        "input": "a42b.b0c1.d2e3",
        "salted_re": "^02[0-9a-f]{2}\\.[0-9a-f]{4}\\.[0-9a-f]{4}$",
        "static": "XXXX.XXXX.XXXX"
      },
      {
        "id": "mac_not_a_layout",
        "method": "mac",
        "input": "N/A-7",
        "salted_re": "^[A-Z]/[A-Z]-[0-9]$",
        "static": "X/X-0"
      },
      {
        "id": "private_ipv4_192",
        "method": "private_ip",
        "input": "192.168.0.12",
        "salted_re": "^192\\.168\\.[0-9]\\.[1-9][0-9]$",
        "static": "192.168.1.11"
      },
      {
        "id": "private_ipv4_10_padded",
        "method": "private_ip",
        "input": "10.1.001.200",
        "salted_re": "^10\\.[0-9]\\.[0-9]{3}\\.(1[0-9]{2}|2[0-4][0-9]|25[0-5])$",
        "static": "10.1.001.111"
      },
      {
        "id": "private_ipv4_172",
        "method": "private_ip",
        "input": "172.20.3.4",
        "salted_re": "^172\\.20\\.[0-9]\\.[0-9]$",
        "static": "172.20.1.1"
      },
      {
        "id": "public_ipv4",
        "method": "public_ip",
        "input": "73.92.144.18",
        "salted_re": "^[1-9][0-9]\\.[1-9][0-9]\\.(1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.[1-9][0-9]$",
        "static": "11.11.111.11"
      },
      {
        "id": "ipv4_not_four_octets",
        "method": "public_ip",
        "input": "1.2.3",
        "salted_re": "^[0-9]\\.[0-9]\\.[0-9]$",
        "static": "0.0.0"
      },
      {
        "id": "ipv6_global",
        "method": "ipv6",
        "input": "2601:1f:a0b:3c00::4d2",
        "salted_re": "^[0-9][0-9]{3}:[0-9][a-f]:[a-f][0-9][a-f]:[0-9][a-f][0-9]{2}::[0-9][a-f][0-9]$",
        "static": "0000:00:000:0000::000"
      },
      {
        "id": "ipv6_link_local_group_kept",
        "method": "ipv6",
        "input": "fe80::a62b:b0ff:fec1:d2e3",
        "salted_re": "^fe80::[a-f][0-9]{2}[a-f]:[a-f][0-9][a-f]{2}:[a-f]{2}[a-f0-9][0-9]:[a-f][0-9][a-f][0-9]$",
        "static": "fe80::0000:0000:0000:0000"
      },
      {
        "id": "ipv6_mapped_dotted_tail",
        "method": "ipv6",
        "input": "::ffff:192.168.1.5",
        "salted_re": "^::[a-f]{4}:(1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.[0-9]\\.[0-9]$",
        "static": "::0000:111.111.1.1"
      },
      {
        "id": "email_tld_kept",
        "method": "email",
        "input": "Ken.Owner@example-mail.com",
        "salted_re": "^[A-Z][a-z]{2}\\.[A-Z][a-z]{4}@[a-z]{7}-[a-z]{4}\\.com$",
        "static": "Xxx.Xxxxx@xxxxxxx-xxxx.com"
      },
      {
        "id": "email_single_label_domain",
        "method": "email",
        "input": "a@localhost",
        "salted_re": "^[a-z]@[a-z]{9}$",
        "static": "x@xxxxxxxxx"
      },
      {
        "id": "email_without_at",
        "method": "email",
        "input": "not-an-email",
        "salted_re": "^[a-z]{3}-[a-z]{2}-[a-z]{5}$",
        "static": "xxx-xx-xxxxx"
      },
      {
        "id": "network_name_with_space",
        "method": "value",
        "prefix": "WIFI",
        "input": "Maplewood Home",
        "salted_re": "^[A-Z][a-z]{8} [A-Z][a-z]{3}$",
        "static": "Xxxxxxxxx Xxxx"
      },
      {
        "id": "passphrase_punctuation_kept",
        "method": "value",
        "prefix": "PASS",
        "input": "p@ss-w0rd!",
        "salted_re": "^[a-z]@[a-z]{2}-[a-z][0-9][a-z]{2}!$",
        "static": "x@xx-x0xx!"
      },
      {
        "id": "hex_token_stays_hex",
        "method": "value",
        "prefix": "TOKEN",
        "input": "eba954f1f10817e8",
        "salted_re": "^[a-f]{3}[0-9]{3}[a-f][0-9][a-f][0-9]{5}[a-f][0-9]$",
        "static": "xxx000x0x00000x0"
      },
      {
        "id": "non_ascii_one_letter_per_byte",
        "method": "value",
        "prefix": "WIFI",
        "input": "Café ☕",
        "salted_re": "^[A-Z][a-z]{4} [a-z]{3}$",
        "static": "Xxxxx xxx"
      },
      {
        "id": "serial",
        "method": "value",
        "prefix": "SERIAL",
        "input": "7ZZ0000FAKE00",
        "salted_re": "^[0-9][A-Z]{2}[0-9]{4}[A-Z]{4}[0-9]{2}$",
        "static": "0XX0000XXXX00"
      }
    ]
  },
  "hash_value_cases": {
    "_comment": "hash_value writes PREFIX_<8 hex> with a salt and ***PREFIX*** without.",
    "cases": [
      {"id": "serial",      "value": "ABC123",       "prefix": "SERIAL"},
      {"id": "token",       "value": "secret-token", "prefix": "TOKEN"},
      {"id": "password",    "value": "password123",  "prefix": "PASS"},
      {"id": "empty_value", "value": "",             "prefix": "EMPTY"}
    ]
  }
}
