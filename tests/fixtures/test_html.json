    {"input_html": "localStorage.setItem(\"api_key\", \"sk_live_moreLightFather\")",      "should_not_contain": "sk_live_moreLightFather",  "should_contain": "STORAGE_", "id": "setitem_api_key"},
    {"input_html": "sessionStorage.setItem(\"auth_token\", \"tok_nexus6_2019\")",         "should_not_contain": "tok_nexus6_2019",         "should_contain": "STORAGE_",  "id": "setitem_auth_token"},
    {"input_html": "localStorage.setItem(\"password\", \"Th3r3IsN0Sp00n!\")",             "should_not_contain": "Th3r3IsN0Sp00n!",         "should_contain": "STORAGE_",  "id": "setitem_password"},
    {"input_html": "localStorage.setItem('token', 'secret_session_abc')",             "should_not_contain": "secret_session_abc",      "should_contain": "STORAGE_",  "id": "setitem_single_quotes"},
    {"input_html": "localStorage.setItem(\"theme\", \"dark\")",                            "should_not_contain": null,                      "should_contain": null,        "id": "setitem_safe_value"},
    {"input_html": "sessionStorage.setItem(\"lang\", \"en\")",                             "should_not_contain": null,                      "should_contain": null,        "id": "setitem_safe_lang"}
