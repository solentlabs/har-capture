{
  "_comment": "PII regression cases drawn from real user-reported leaks. Each row is a value that should be flagged by the heuristic engine with a meaningful category for the Pass 2 review UI. Values are synthetic, in the layouts the reports showed.",
  "heuristic_regression_cases": [
    {
      "value": "6XY1234ZQWERT",
      "should_flag": true,
      "expected_category": "serial_number",
      "id": "netgear_c7000v2_serial",
      "source": "Netgear C7000v2 RouterStatus.htm serial; 13-char Netgear format, HIGH so review pre-selects",
      "expected_confidence": "high"
    },
    {
      "value": "SPSETUP-9F3A2",
      "should_flag": true,
      "expected_category": "wifi_ssid",
      "id": "spsetup_default_ssid",
      "source": "user-reported leak — default SSID format SPSETUP-xxxx"
    },
    {
      "value": "Lantern555glove",
      "should_flag": true,
      "expected_category": "credential",
      "id": "default_password_mixed",
      "source": "user-reported leak — default password format with prefix word + digits + suffix"
    },
    {
      "value": "7TH4582JK9QP",
      "should_flag": true,
      "expected_category": "serial_number",
      "id": "generic_uppercase_alnum_serial",
      "source": "user-reported leak — SN-HERE placeholder; representative 12-char uppercase-alphanumeric serial token covered by the broader serial_number backstop",
      "expected_confidence": "medium"
    },
    {
      "value": "7S0245KL9BAAA",
      "should_flag": true,
      "expected_category": "serial_number",
      "expected_confidence": "high",
      "id": "netgear_cm2500_7s_serial",
      "source": "Netgear CM2500 — 7S-prefix Netgear serial was only medium-flagged and needed manual selection in review"
    }
  ],
  "_followup_regex_layer": "WPS PIN (8 bare digits) belongs in the regex layer — see regex_layer_regression_cases below. Heuristics can't disambiguate a WPS PIN from a packet counter; the adjacent label is what makes 100% confidence achievable per docs/ARCHITECTURE.md § Confidence boundary.",
  "regex_layer_regression_cases": [
    {
      "input_html": "WPS PIN: 12345678",
      "leaked_value": "12345678",
      "expected_prefix": "PIN_",
      "id": "wps_pin_inline",
      "source": "user-reported leak — WPS PIN sanitization"
    },
    {
      "input_html": "<td>WPS PIN</td><td>87654321</td>",
      "leaked_value": "87654321",
      "expected_prefix": "PIN_",
      "id": "wps_pin_inline_html",
      "source": "user-reported leak — WPS PIN sanitization (HTML)"
    },
    {
      "input_html": "PIN Code: 11223344",
      "leaked_value": "11223344",
      "expected_prefix": "PIN_",
      "id": "pin_code_label",
      "source": "user-reported leak — alternate label format"
    },
    {
      "input_html": "WPS-PIN 99887766",
      "leaked_value": "99887766",
      "expected_prefix": "PIN_",
      "id": "wps_pin_hyphenated_label",
      "source": "user-reported leak — hyphenated label variant"
    },
    {
      "input_html": "Pairing PIN = 55667788",
      "leaked_value": "55667788",
      "expected_prefix": "PIN_",
      "id": "pairing_pin_equals",
      "source": "user-reported leak — pairing-PIN label, equals separator"
    },
    {
      "input_html": "<div class=\"form-row odd\">\n\t<span class=\"readonlyLabel\" id=\"hardmess2\">Serial Number:</span>\n\t<span class=\"value\">\n\t1234567890123456</span>\n</div>",
      "leaked_value": "1234567890123456",
      "expected_prefix": "SERIAL_",
      "id": "technicolor_jst_sibling_span_serial",
      "source": "Technicolor CGM4981COM — Technicolor CGM4981COM hardware.jst renders label and value in sibling spans with whitespace between the tags"
    },
    {
      "input_html": "<span class=\"readonlyLabel\">WPS PIN:</span>\n<span class=\"value\">\n13572468</span>",
      "leaked_value": "13572468",
      "expected_prefix": "PIN_",
      "id": "wps_pin_sibling_span",
      "source": "Technicolor CGM4981COM — sibling-span markup applied to the WPS PIN label pattern, which shares the tag-chain construct"
    },
    {
      "input_html": "<td>\n<strong>Serial Number</strong>\n</td>\n<td>\n9876543210ABCD</td>",
      "leaked_value": "9876543210ABCD",
      "expected_prefix": "SERIAL_",
      "id": "serial_td_whitespace_between_tags",
      "source": "Technicolor CGM4981COM — table-cell variant with newlines between tags, same tag-chain construct in the table pass"
    }
  ],
